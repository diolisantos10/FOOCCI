{
  "extends": [
    "next/core-web-vitals"
  ],
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "excludedFiles": [
        "src/lib/openai.ts",
        "src/services/brain/engines/**",
        "src/**/*.test.ts",
        "src/services/ai/AIOrderService.ts",
        "src/services/ai/AISimulatorService.ts",
        "src/services/ai/AITools.ts",
        "src/services/ai/ChatSimService.ts",
        "src/services/ai/PromptBuilderService.ts",
        "src/services/ai/WhatsAppReceptionistService.ts",
        // embeddings não passam pelo chat dispatcher
        "src/services/brain/knowledge/KnowledgeEmbeddingService.ts",
        "src/services/imageEnhancement/providers/openai.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "openai",
                "message": "Regra de Ouro (Lei 1): agentes raciocinam através do Brain. Use selectEngine()+callStructuredJson() de src/services/brain/engines — não fale com a IA-piloto direto."
              },
              {
                "name": "@/lib/openai",
                "message": "Regra de Ouro (Lei 1): agentes raciocinam através do Brain. Use selectEngine()+callStructuredJson() de src/services/brain/engines — não fale com a IA-piloto direto."
              }
            ]
          }
        ]
      }
    }
  ]
}
