# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# Env files – NEVER commit real secrets
.env
.env.local
.env.*.local

# Keep the example template
!.env.example

# Prisma – migrations must be committed to version control (Prisma best practice)
# prisma/migrations/   <-- intentionally NOT ignored

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Claude Code worktrees (agent isolation, not source code)
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts
qa-reports/*.json
qa-reports/*.md

# Playwright
playwright-report/
test-results/

# User-uploaded files (runtime)
public/uploads/*
!public/uploads/.gitkeep
.next-ui/
