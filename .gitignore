# Dependencies
# Sem a barra de propósito: `node_modules/` casa só DIRETÓRIO. Um worktree que
# aponta node_modules para outro lugar cria um SYMLINK — que é arquivo, escapava
# deste padrão e foi parar num commit em 23/08/2026. O build do Railway morreu com
# "cannot replace to directory /app/node_modules with file". Sem a barra, casa os dois.
node_modules
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# Env files – NEVER commit real secrets
.env
.env.local
.env.*.local

# Keep the example template
!.env.example

# Prisma – migrations must be committed to version control (Prisma best practice)
# prisma/migrations/   <-- intentionally NOT ignored

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Claude Code worktrees (agent isolation, not source code)
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts
qa-reports/*.json
qa-reports/*.md

# Playwright
playwright-report/
test-results/

# User-uploaded files (runtime)
public/uploads/*
!public/uploads/.gitkeep
.next-ui/
