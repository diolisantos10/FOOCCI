# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_restaurante?schema=public"

# ─────────────────────────────────────────────
# AUTH (NextAuth)
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CRM Restaurante"

# ─────────────────────────────────────────────
# RATE LIMITING (Phase 2 – Upstash Redis)
# ─────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ─────────────────────────────────────────────
# WHATSAPP / META (Phase 2)
# ─────────────────────────────────────────────
# META_WEBHOOK_VERIFY_TOKEN=""
# META_APP_SECRET=""

# ─────────────────────────────────────────────
# EVOLUTION API – WHATSAPP (Phase 3)
# ─────────────────────────────────────────────
# Used to encrypt Evolution API credentials at rest in the database.
# Generate with: openssl rand -hex 32
# IMPORTANT: Changing this key will invalidate all existing encrypted values.
ENCRYPTION_KEY="replace-with-64-hex-chars-generated-by-openssl-rand-hex-32"

# ─────────────────────────────────────────────
# AI (Phase 4)
# ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────────
# FILE STORAGE (Phase 2)
# ─────────────────────────────────────────────
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
