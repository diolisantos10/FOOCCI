# ─────────────────────────────────────────────────────────────────
# REQUIRED — system will not start without these
# ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Railway provides this automatically
# when you add a Postgres plugin to the service)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_restaurante?schema=public"

# NextAuth session signing key
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-strong-random-secret"

# Your Railway public domain, e.g. https://foocci-production.up.railway.app
# No trailing slash. Used for OAuth redirect URIs and callbackUrl generation.
NEXTAUTH_URL="https://your-app.up.railway.app"

# AES-256-GCM key for encrypting Evolution API credentials at rest.
# Generate: openssl rand -hex 32   (must be exactly 64 hex characters)
# WARNING: Changing this invalidates ALL stored Evolution configs in the DB.
ENCRYPTION_KEY="64-hex-chars-from-openssl-rand-hex-32"

# OpenAI API key — required for the AI ordering engine, AI simulator, and the
# WhatsApp Brain front door. Without it the Brain degrades safely ("let me confirm").
OPENAI_API_KEY="sk-..."

# Anthropic API key (Claude) — provider alternativo opcional para o Brain de IA.
# Se definida, o roteador de IA pode usar o Claude; caso contrário, usa OPENAI_API_KEY.
ANTHROPIC_API_KEY="sk-ant-..."

# WhatsApp Brain front door — the Brain answers WhatsApp messages (intent-aware,
# knowledge-grounded) instead of the legacy receptionist. ON by default.
# Set to "false" to disable and fall back to the old receptionist.
WHATSAPP_BRAIN_ENABLED="true"

# ─────────────────────────────────────────────────────────────────
# RECOMMENDED — safe defaults if not provided; features degrade gracefully
# ─────────────────────────────────────────────────────────────────

# Public URL shown to customers (QR codes, order links, etc.)
# Usually same as NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# Baked into the build — appears in browser console via AppVersionLogger.
# Leave blank to use the version from package.json automatically.
# NEXT_PUBLIC_APP_VERSION=

# Emergency admin endpoint (/api/admin/reset-owner, /api/admin/force-deploy).
# Endpoint is DISABLED if this is not set — safe to omit in production.
# Generate: openssl rand -hex 16
# ADMIN_SECRET=

# Build OS WhatsApp Master/Admin channel (system-level, NO restaurant).
# Used by /admin/build-os → Configuração to connect the Foocci/Futi Admin number.
# Optional: when set, the admin card can connect QR without pasting an apiKey.
# EVOLUTION_DEFAULT_URL is also used as the suggested baseUrl.
# EVOLUTION_DEFAULT_URL=https://evo.example.com
# EVOLUTION_DEFAULT_API_KEY=

# ── Official Meta WhatsApp Cloud API (parallel provider; Evolution stays default) ──
# Disabled by default — set to "true" only when the Meta app + Embedded Signup are
# configured. Restaurants stay on Evolution until they explicitly switch.
# Webhook URL (configure in the Meta app): https://foocci.com.br/api/webhooks/meta/whatsapp
# Webhook field to subscribe: messages
#
# REQUIRED (server):
META_WHATSAPP_ENABLED="false"   # master flag — "true" enables the Meta provider/UI
# META_APP_ID=                  # Meta app id (token exchange + browser SDK)
# META_APP_SECRET=              # app secret — token exchange AND webhook signature (X-Hub-Signature-256)
# META_CONFIG_ID=               # Embedded Signup configuration id
# META_WEBHOOK_VERIFY_TOKEN=    # webhook GET verify token (must match the Meta app config)
#
# RECOMMENDED (server):
# META_TEST_PHONE=              # internal test number for the safe connection test
# META_GRAPH_VERSION="v21.0"    # Graph API version. NOTE: the code reads META_GRAPH_VERSION (NOT META_GRAPH_API_VERSION)
#
# REQUIRED (client/build-time) — Next.js inlines NEXT_PUBLIC_* at BUILD, so a REDEPLOY
# is required after changing these for the browser (Embedded Signup) to pick them up:
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=

# Railway deploy hook URL — used by /api/admin/force-deploy and scripts/force-deploy.sh.
# Get it from: Railway dashboard → Project → Service → Settings → Deploy → Deploy Hook
# Required for the GitHub Actions auto-deploy workflow to work.
# RAILWAY_WEBHOOK_URL="https://backboard.railway.app/webhooks/deploy/..."

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — enable only when the integration is active
# ─────────────────────────────────────────────────────────────────

# AWS S3 — for product image uploads.
# If not set, image upload feature is disabled (no crash).
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""

# Stone payment gateway — hosted payment links.
# If STONE_CLIENT_ID is not set, payment link generation is disabled.
# STONE_CLIENT_ID=""
# STONE_CLIENT_SECRET=""
# STONE_TOKEN_URL="https://sandbox-auth.openbank.stone.com.br/auth/realms/stone_bank/protocol/openid-connect/token"
# STONE_API_URL="https://sandbox-api.openbank.stone.com.br/api/v1"
# STONE_WEBHOOK_SECRET=""

# Mercado Pago — webhook signature verification.
# Found in: MP Developer Panel → Your application → Webhooks → Secret.
# When set, the /api/payments/mercadopago/webhook endpoint verifies the
# x-signature HMAC-SHA256 on every Webhooks API notification and rejects
# requests with a missing or invalid signature (HTTP 401).
# Without this, verification is skipped and a CRITICAL warning is logged on
# every webhook event in production.
# MERCADO_PAGO_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────────
# AI AGENTS ADMIN — Phase 1 foundation (internal)
# ─────────────────────────────────────────────────────────────────
# Master kill-switch for DB-driven AI agent profiles at RUNTIME.
# DEFAULT OFF. Leave unset/false in Phase 1: the Waiter runtime keeps reading
# its code-defined constitution and the database is data-only (seed + Admin UI).
# Only flip to "true" during the deliberate Phase 3 rollout, and even then a
# profile must ALSO have isRuntimeEnabled=true to affect runtime.
# AGENT_PROFILE_DB_ENABLED="false"

# ─────────────────────────────────────────────────────────────────
# BUILD OS — Prompt Relay / Command Router (internal)
# ─────────────────────────────────────────────────────────────────
# NORMAL configuration now lives in the admin UI (/admin/build-os → Configuração),
# stored in the database. The variables below are BOOTSTRAP / EMERGENCY ONLY.
#
# Enable precedence: BUILDOS_HARD_DISABLED → DB config (admin) → BUILDOS_ENABLED.
#
# Emergency hard kill-switch. When "true", Build OS NEVER processes commands,
# even if the database config says enabled. Use to stop everything instantly.
# BUILDOS_HARD_DISABLED="false"
#
# Bootstrap enable fallback — used ONLY when no DB config row exists yet.
# Once the admin saves config in the UI, the DB value takes over.
# BUILDOS_ENABLED="false"
#
# Bootstrap operator allow-list (E.164, comma-separated) — used as a fallback
# when there are no active DB operators, OR when the admin config allows env
# fallback. Prefer adding operators in the admin UI instead.
# BUILD_OS_AUTHORIZED_PHONES="+5511999999999,+5511888888888"

# ─────────────────────────────────────────────────────────────────
# MARKETING PREVIEW — private pre-launch gate for the /site marketing website
# ─────────────────────────────────────────────────────────────────
# While Foocci is in pilot, the public marketing site (/site) is kept PRIVATE behind
# a single shared password. Set this to a strong value to unlock the preview at
# /site/entrar. When UNSET, /site is fully locked (fail-closed) and never public.
# Scoped strictly to /site — does not affect product routes, auth or webhooks.
# Remove the gate at public launch. See docs/foocci-site/private-preview-v1.md.
# MARKETING_PREVIEW_PASSWORD="change-me-strong-preview-password"
