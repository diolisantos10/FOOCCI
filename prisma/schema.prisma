// ─────────────────────────────────────────────────────────────
//  CRM Restaurante – Prisma Schema
//  Phase 2: OrderDraft, OrderDraftItem, FulfillmentType, OrderDraftStatus.
//  Phase 3: EvolutionConfig, Conversation.lastMessageAt/unreadCount,
//           Message.externalMessageId/externalStatus.
//  Phase 4: RestaurantBrandConfig (AI brand voice),
//           AIInteractionLog.toolCalls/turnNumber/estimatedCostUsd.
// ─────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════
//  TENANT – RESTAURANT
// ═══════════════════════════════════════════

model Restaurant {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  phone           String?
  email           String?
  logoUrl         String?
  address         String?
  description     String?
  timezone        String  @default("America/Sao_Paulo")
  isActive        Boolean @default(true)
  // Restaurante de DEMONSTRAÇÃO — vitrine do site de vendas, sandbox de treino.
  // NÃO é cliente: não entra em cobrança, relatório comercial nem métrica de base.
  // É coluna e não convenção de slug de propósito (guardrail 4: código é a trava) —
  // uma regra escrita só no nome do slug some na primeira renomeação.
  // Filtro canônico e a trava de cobrança vivem em src/lib/demo-restaurant.ts.
  isDemo          Boolean @default(false)
  // Master switch do Agente de CRM. false = CRM roda 100% na mão (sem IA).
  crmAgentEnabled Boolean @default(true)
  plan            Plan    @default(STARTER)

  /// A CHAVE DE IDEMPOTÊNCIA do checkout self-service. Preenchida quando este
  /// restaurante nasceu do pagamento de uma PlanSubscription. É UNIQUE de
  /// propósito: o webhook do Mercado Pago reenvia o mesmo evento, e é este índice
  /// — no banco, não no código — que garante que dois webhooks concorrentes não
  /// criem dois restaurantes para a mesma assinatura. O segundo INSERT viola a
  /// restrição e a transação inteira volta atrás, sem deixar nada pela metade.
  /// Não é FK: a direção da posse é PlanSubscription.restaurantId.
  originSubscriptionId String?  @unique
  // Whether the AI Waiter is available on this restaurant's public store.
  // NULL = derive from plan (STARTER → no, GROWTH/PRO → yes). The migration
  // grandfathers every restaurant existing at rollout to TRUE: Sushi Cazza — the
  // live customer — is on STARTER *with* the Waiter running, and a naive
  // plan-only gate would have shut down its AI in production (guardrail 5).
  aiWaiterEnabled      Boolean?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Emergency store pause — overrides business hours
  isOrderingPaused     Boolean   @default(false)
  orderingPausedReason String?
  orderingPausedAt     DateTime?
  orderingPausedUntil  DateTime?
  orderingPausedBy     String?

  // Monotonic per-restaurant counter for human-friendly sequential order numbers.
  // Incremented atomically inside the order-creation transaction.
  lastOrderNumber Int @default(0)

  // Seleção de provedor de WhatsApp (whatsappProvider / fallbackProvider /
  // allowWhatsAppProviderFallback) foi REMOVIDA em 04/08/2026: a Meta Cloud API
  // é o canal único e não há segundo provedor para escolher nem para onde cair.

  users                   User[]
  customers               Customer[]
  menuCategories          MenuCategory[]
  orders                  Order[]
  orderDrafts             OrderDraft[]
  campaigns               Campaign[]
  conversations           Conversation[]
  helpThreads             HelpThread[]
  offers                  Offer[]
  customerSegments        CustomerSegment[]
  aiLogs                  AIInteractionLog[]
  metaWhatsAppConfig      MetaWhatsAppConfig?
  metaMessageTemplates    MetaMessageTemplate[]
  brandConfig             RestaurantBrandConfig?
  agentConfig             WhatsAppAgentConfig?
  deliveryConfig          DeliveryConfig?
  deliveryZones           DeliveryZone[]
  businessHours           BusinessHours[]
  paymentSettings         PaymentSettings?
  storePolicies           StorePolicies?
  storeProfile            StoreProfile?
  integrationConfigs      IntegrationConfig[]
  promotions              Promotion[]
  customerCoupons         CustomerCoupon[]
  crmAutomations          CRMAutomation[]
  crmCustomActions        CRMCustomAction[]
  crmActionLogs           CRMActionLog[]
  crmProfile              RestaurantCRMProfile?
  autoSimulatorConfig     AutoSimulatorConfig?
  simulationRuns          SimulationRun[]
  trackingLinks           TrackingLink[]
  importJobs              ImportJob[]
  importMappingTemplates  ImportMappingTemplate[]
  tierSettings            TierSettings?
  tierBenefits            TierBenefit[]
  onboardingStatus        RestaurantOnboardingStatus?
  productSalesAggregates  ProductSalesAggregate[]
  customerDataSignals     CustomerDataSignal[]
  knowledgeItems          RestaurantKnowledgeItem[]
  orderEditLogs           OrderEditLog[]
  agentProfileOverrides   RestaurantAgentProfileOverride[]
  agencyProjects          AgencyProject[]
  waOrderingSessions      WhatsAppOrderingSession[]
  waTextOrderingConfig    WhatsAppTextOrderingConfig?
  soundSettings           RestaurantSoundSettings?
  printStations           PrintStation[]
  printAgent              PrintAgent?
  printJobs               PrintJob[]
  googleIntegrationConfig GoogleIntegrationConfig?
  apiKeys                 ApiKey[]
  waMenuLinks             WaMenuLink[]
  pricingConfig           RestaurantPricingConfig?
  priceChangeLogs         PriceChangeLog[]
  ingredients             Ingredient[]
  fiscalConfig            FiscalConfig?
  fiscalDocuments         FiscalDocument[]
  planSubscriptions       PlanSubscription[]

  @@map("restaurants")
}

// ═══════════════════════════════════════════
//  EXTERNAL API ACCESS (Integrações → Conexões externas)
// ═══════════════════════════════════════════
//
// A read-only Bearer key the lojista generates so external systems (first
// consumer: Foocci Manager, the finance module) can pull this restaurant's
// sales from GET /api/v1/vendas. Security model:
//   • The plaintext token is shown to the user ONCE at creation; only its
//     SHA-256 hash is stored here — a DB leak never exposes a usable token.
//   • Scoped to a single restaurant (the token itself resolves the tenant, so
//     the external caller never sends a restaurant id).
//   • Revocable (revokedAt) — a revoked key stops authenticating immediately.
//   • tokenPrefix is a short, non-secret fragment ("fck_ab12…") shown in the
//     list so the user can tell keys apart without ever re-revealing the secret.
model ApiKey {
  id              String    @id @default(cuid())
  restaurantId    String
  name            String? // friendly label, e.g. "Foocci Manager"
  tokenHash       String    @unique // SHA-256 hex of the plaintext token
  tokenPrefix     String // non-secret display fragment, e.g. "fck_ab12cd34"
  scope           String    @default("sales:read") // read-only today; room to grow
  lastUsedAt      DateTime? // updated (throttled) on each authenticated call
  createdByUserId String?
  revokedAt       DateTime? // non-null → key no longer authenticates
  createdAt       DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tokenHash])
  @@map("api_keys")
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

// ═══════════════════════════════════════════
//  USERS
// ═══════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String
  password     String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([email, restaurantId])
  @@index([restaurantId])
  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

// ═══════════════════════════════════════════
//  CUSTOMERS
// ═══════════════════════════════════════════

model Customer {
  id                     String    @id @default(cuid())
  restaurantId           String
  name                   String
  phone                  String? // E.164 format – WhatsApp identifier, or GUEST-{uuid} for anon; null for no-phone imports
  email                  String?
  birthDate              DateTime?
  notes                  String?
  document               String? // CPF or CNPJ
  financialBalance       Decimal?  @db.Decimal(10, 2) // Saldo Financeiro Total
  financialBalancePeriod Decimal?  @db.Decimal(10, 2) // Saldo Financeiro do Período
  importedOrderCount     Int? // Qtd. Pedidos — from external import
  importedTotalSpent     Decimal?  @db.Decimal(10, 2) // Valor Total — from external import
  importedLastOrderAt    DateTime? // Última Compra — from external import
  averageTicket          Decimal?  @db.Decimal(10, 2) // Ticket Médio — from external import
  totalOrders            Int       @default(0)
  totalSpend             Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderAt            DateTime?
  tier                   String    @default("BRONZE") // BRONZE | PRATA | OURO | DIAMANTE
  previousTier           String? // tier before the last level-up (drives "Subiu de nível")
  tierUpAt               DateTime? // when the customer last moved UP a tier
  segment                String    @default("SEM_PEDIDOS") // QUENTE | MORNO | FRIO | SEM_PEDIDOS
  isActive               Boolean   @default(true)
  isGuest                Boolean   @default(false) // true = anonymous session; excluded from CRM lists and metric sync
  hasOptedOut            Boolean   @default(false) // LGPD: customer requested opt-out from marketing messages
  optOutAt               DateTime?
  crmContactable         Boolean   @default(true) // false = no valid phone; excluded from WhatsApp campaigns
  contactStatus          String? // CONTACTABLE | SEM_TELEFONE | TELEFONE_INVALIDO | OPT_OUT | NEEDS_REVIEW
  importExternalId       String? // stable dedup key for re-imports
  sourceSystem           String? // SAIPOS | NEMO | SAIPOS+NEMO | MANUAL
  dataEnrichmentStatus   String? // COMPLETE | PARTIAL | NEEDS_ENRICHMENT | NEEDS_REVIEW
  dataCompletenessScore  Int? // 0–100 computed by CustomerIntelligenceService
  lastEnrichmentAt       DateTime? // last time enrichment data was updated
  enrichmentNotes        String? // free-form notes from CRM agent / human
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  restaurant     Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses      Address[]
  orders         Order[]
  orderDrafts    OrderDraft[]
  conversations  Conversation[]
  preferences    CustomerPreference?
  segmentMembers CustomerSegmentMembership[]
  dataSignals    CustomerDataSignal[]
  coupons        CustomerCoupon[]

  @@unique([phone, restaurantId])
  @@index([restaurantId])
  @@index([restaurantId, crmContactable])
  @@map("customers")
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderDrafts OrderDraft[] // drafts referencing this address
  orders      Order[] // orders referencing this address

  @@index([customerId])
  @@map("addresses")
}

model CustomerPreference {
  id           String   @id @default(cuid())
  customerId   String   @unique
  dietary      String[]
  allergies    String[]
  favoriteDish String?
  notes        String?
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

// ═══════════════════════════════════════════
//  MENU
// ═══════════════════════════════════════════

model MenuCategory {
  id               String     @id @default(cuid())
  restaurantId     String
  name             String
  description      String?
  imageUrl         String?
  // Markup multiplier override for /precificacao (null = use the restaurant's
  // global markup from RestaurantPricingConfig). Sector practice: pratos
  // 2,5–3× · bebidas/sobremesas 4–5×.
  markupOverride   Decimal?   @db.Decimal(6, 3)
  sortOrder        Int        @default(0)
  isActive         Boolean    @default(true)
  isAvailable      Boolean    @default(true) // false = category temporarily unavailable (does not modify item flags)
  showInDelivery   Boolean    @default(true) // false = category hidden from delivery channel
  showInDineIn     Boolean    @default(true) // false = category hidden from QR dine-in menu
  source           MenuSource @default(MANUAL) // tracks whether created manually or via external integration
  printStationKeys String[]   @default([]) // routing: which print station(s) this category's items print at — can be several (same dish in two kitchens)
  // ── Fiscal (NFC-e) — defaults por categoria; item sobrepõe, config global é o fallback ──
  fiscalNcm        String? // NCM (8 díg). Ex.: refeições prontas 21069090
  fiscalCest       String? // CEST (ST), quando aplicável
  fiscalCfop       String? // CFOP da operação (ex.: 5102)
  fiscalCsosn      String? // Simples Nacional (ex.: 102, 500)
  fiscalCst        String? // Regime normal (ICMS)
  fiscalOrigem     String? // origem da mercadoria (0=nacional)
  fiscalUnidade    String? // unidade comercial (ex.: UN)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]
  placements MenuItemPlacement[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id                    String   @id @default(cuid())
  categoryId            String
  name                  String
  description           String?
  ingredients           String? // composition for AI suggestions
  price                 Decimal  @db.Decimal(10, 2) // base/fallback price (used when a channel price is null)
  // ── Channel-based pricing (null = fall back to base `price`) ──────────
  priceDelivery         Decimal? @db.Decimal(10, 2) // price shown/used on the /pedido delivery channel
  priceDineIn           Decimal? @db.Decimal(10, 2) // price shown/used on the /qr salão (dine-in) channel
  priceIfood            Decimal? @db.Decimal(10, 2) // price for iFood (export/admin; integration optional)
  // ── CMV / precificação ────────────────────────────────────────────────
  cost                  Decimal? @db.Decimal(10, 2) // unit cost (CMV por item) — edited on /precificacao; null = not informed yet
  imageUrl              String?
  // Carrossel de fotos (opt-in por item). imageUrl continua sendo a CAPA (thumbnails,
  // cards, WhatsApp/agente, OG, exports). `images` é o conjunto extra mostrado só na
  // ficha do produto quando carouselEnabled = true; ordem do array = ordem do carrossel.
  images                String[] @default([])
  carouselEnabled       Boolean  @default(false)
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  // Availability + channel control
  isAvailable           Boolean  @default(true) // false = temporarily sold out (shown as Indisponível)
  showInDelivery        Boolean  @default(true) // false = hidden from Foocci ordering channel
  showInDineIn          Boolean  @default(true) // false = hidden from QR dine-in menu
  hasVariants           Boolean  @default(false) // true = must select a variant before add-to-cart
  code                  String?
  servingSize           Int? // number of people (1, 2, 3, 4+)
  portionInfo           String? // free-text weight/volume e.g. "300g", "500ml"
  // ── AI enrichment fields ──────────────────────────────────────────
  tagFunil              String? // funnel stage: Entrada | Prato Principal | Bebida | Sobremesa
  perfilPaladar         String? // sensory profile for AI descriptions (umami, cítrico, cremoso…)
  harmonizacaoSugerida  String? // item ID or name to suggest at checkout if category missing from cart
  alergenosDetalhados   String? // comma-separated allergen list (glúten, lactose, frutos do mar…)
  storytellingIA        String? // curated narrative to use when customer asks "what makes it special"
  // ── Saipos POS integration ────────────────────────────────────────────
  saiposIntegrationCode String? // codigo_saipos — PDV code sent as integration_code in Saipos orders
  // ── Fiscal (NFC-e) — override por item; herda da categoria e depois do default global ──
  fiscalNcm             String? // NCM (8 díg)
  fiscalCest            String? // CEST (ST) quando aplicável
  fiscalCfop            String? // CFOP da operação
  fiscalCsosn           String? // Simples Nacional (CSOSN)
  fiscalCst             String? // Regime normal (CST ICMS)
  fiscalOrigem          String? // origem (0=nacional)
  fiscalUnidade         String? // unidade comercial
  fiscalIcmsAliquota    Decimal? @db.Decimal(6, 3) // alíquota ICMS % (regime normal)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category         MenuCategory              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  orderDraftItems  OrderDraftItem[]
  variants         MenuItemVariant[]
  extras           MenuItemExtra[]
  optionGroups     OptionGroup[]
  placements       MenuItemPlacement[]
  imageEnhancement MenuItemImageEnhancement?
  recipeLines      RecipeLine[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemPlacement {
  id         String @id @default(cuid())
  itemId     String
  categoryId String
  sortOrder  Int    @default(0)

  item     MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([itemId, categoryId])
  @@index([categoryId])
  @@map("menu_item_placements")
}

model MenuItemVariant {
  id                    String   @id @default(cuid())
  menuItemId            String
  name                  String // e.g. "350ml", "600ml", "2L"
  // Optional. null = inherit the parent MenuItem's price for the channel/context
  // (priceDelivery/priceDineIn/priceIfood → base). A value here OVERRIDES the product.
  price                 Decimal? @db.Decimal(10, 2) // base/fallback variant price (null = inherit product)
  // ── Channel-based pricing for this variant (null = fall back to `price`) ──
  priceDelivery         Decimal? @db.Decimal(10, 2)
  priceDineIn           Decimal? @db.Decimal(10, 2)
  priceIfood            Decimal? @db.Decimal(10, 2)
  imageUrl              String? // optional per-variant photo; falls back to the product image when null
  portion               String? // e.g. "300g", "500ml"
  isAvailable           Boolean  @default(true)
  sortOrder             Int      @default(0)
  saiposIntegrationCode String? // PDV code for this variant
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

// ═══════════════════════════════════════════
//  CMV & PRECIFICAÇÃO  (página /precificacao)
// ═══════════════════════════════════════════
//
// The lojista registers each item's unit cost (MenuItem.cost) plus the
// restaurant's markup assumptions here. The engine derives the ideal price:
//   markup = 100 / (100 − (fixas% + impostos/taxas% + margem%))
//   ideal  = cost × markup  (then rounded per `rounding`)
// The reprice device reacts to cost/assumption changes according to
// `autoRepriceMode`. Every applied change is audited in PriceChangeLog.

enum AutoRepriceMode {
  OFF // page only shows ideal prices; nothing ever changes on its own
  SUGGEST // change → pending suggestion; lojista applies with 1 click (default)
  AUTO // change → price applied immediately, within maxAutoChangePct guardrail
}

enum PriceRounding {
  NONE // exact value, 2 decimal places
  ENDING_90 // round UP to the next price ending in ,90 (default)
  ENDING_99 // round UP to the next price ending in ,99
}

enum PriceChangeSource {
  MANUAL // price typed directly by the lojista
  APPLIED // lojista applied a suggested price (individual or bulk)
  AUTO // applied by AutoRepriceMode.AUTO after a cost/assumption change
  COST_EDIT // cost updated (price untouched) — kept for a complete audit trail
  RECIPE // cost recomputed from the ingredient ficha (recipe lines)
}

// Catálogo de insumos do restaurante (aba Insumos em /precificacao).
// Seeded automatically from MenuItem.ingredients free text on first visit.
model Ingredient {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  unit         String   @default("un") // un, g, kg, ml, L, fatia, porção…
  costPerUnit  Decimal? @db.Decimal(12, 4) // custo por unidade; null = não informado
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipeLines RecipeLine[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("ingredients")
}

// Ficha técnica: quanto de cada insumo entra em cada produto.
// quantity NULL = link importado do cardápio ainda sem quantidade — não entra
// na conta. Quando TODAS as linhas de um produto têm quantity + costPerUnit,
// o custo do produto passa a ser calculado (source RECIPE) e propaga para o
// dispositivo de reprecificação.
model RecipeLine {
  id           String   @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Decimal? @db.Decimal(12, 4) // na unidade de USO (abaixo)
  unit         String? // unidade de uso no prato; null = usa a unidade de compra do insumo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

model RestaurantPricingConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // Markup assumptions (percentages of the selling price)
  monthlyRevenue       Decimal? @db.Decimal(12, 2) // faturamento médio mensal — converts fixed R$ → %
  fixedExpensesMonthly Decimal? @db.Decimal(12, 2) // despesas fixas mensais (aluguel, equipe, luz…)
  taxesFeesPct         Decimal  @default(0) @db.Decimal(5, 2) // impostos + taxas de cartão/apps
  targetProfitPct      Decimal  @default(0) @db.Decimal(5, 2) // margem de lucro desejada

  // Reprice device
  autoRepriceMode  AutoRepriceMode @default(SUGGEST)
  rounding         PriceRounding   @default(ENDING_90)
  maxAutoChangePct Decimal         @default(15) @db.Decimal(5, 2) // AUTO applies only up to this variation; beyond it stays a suggestion

  // CMV do período (optional gauge: opening stock + purchases − closing stock)
  periodOpeningStock Decimal? @db.Decimal(12, 2)
  periodPurchases    Decimal? @db.Decimal(12, 2)
  periodClosingStock Decimal? @db.Decimal(12, 2)
  periodRevenue      Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_pricing_configs")
}

model PriceChangeLog {
  id              String            @id @default(cuid())
  restaurantId    String
  // Intentionally NOT a FK to MenuItem: the audit trail must survive item
  // deletion. itemName is denormalized for the same reason.
  menuItemId      String
  itemName        String
  oldPrice        Decimal?          @db.Decimal(10, 2)
  newPrice        Decimal?          @db.Decimal(10, 2)
  oldCost         Decimal?          @db.Decimal(10, 2)
  newCost         Decimal?          @db.Decimal(10, 2)
  source          PriceChangeSource
  changedByUserId String?
  createdAt       DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([menuItemId])
  @@map("price_change_logs")
}

// ═══════════════════════════════════════════
//  ORDER DRAFTS  (mutable cart before confirmation)
// ═══════════════════════════════════════════

model OrderDraft {
  id                String           @id @default(cuid())
  restaurantId      String
  customerId        String
  conversationId    String? // nullable – set when draft originates from WhatsApp (Phase 3)
  status            OrderDraftStatus @default(OPEN)
  fulfillmentType   FulfillmentType  @default(DELIVERY)
  deliveryAddressId String? // FK to Address; null for PICKUP/DINE_IN
  subtotal          Decimal          @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal          @default(0) @db.Decimal(10, 2)
  notes             String?
  aiSummary         String? // Phase 3: AI-generated order summary
  confirmedAt       DateTime?
  abandonedAt       DateTime?
  recoveryAttempts  Int              @default(0)
  lastRecoveryAt    DateTime?
  recoveryCode      String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id])
  deliveryAddress Address?         @relation(fields: [deliveryAddressId], references: [id])
  items           OrderDraftItem[]
  order           Order? // populated after confirmation

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@map("order_drafts")
}

model OrderDraftItem {
  id           String   @id @default(cuid())
  orderDraftId String
  menuItemId   String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2) // snapshot of price at time of add
  isUpsell     Boolean  @default(false) // true if suggested by AI upsell (Phase 3)
  notes        String?
  addedAt      DateTime @default(now())

  orderDraft OrderDraft @relation(fields: [orderDraftId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderDraftId])
  @@map("order_draft_items")
}

enum OrderDraftStatus {
  OPEN
  CONFIRMED
  ABANDONED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ═══════════════════════════════════════════
//  ORDERS  (immutable after confirmation)
// ═══════════════════════════════════════════

model Order {
  id                   String      @id @default(cuid())
  restaurantId         String
  customerId           String
  orderNumber          Int? // human-friendly sequential number, unique per restaurant; null for legacy orders
  orderDraftId         String?     @unique // traceability back to originating draft
  status               OrderStatus @default(PENDING)
  type                 OrderType   @default(DELIVERY)
  subtotal             Decimal     @db.Decimal(10, 2)
  deliveryFee          Decimal     @default(0) @db.Decimal(10, 2)
  discount             Decimal     @default(0) @db.Decimal(10, 2)
  total                Decimal     @db.Decimal(10, 2)
  notes                String?
  deliveryAddressId    String? // FK to Address snapshot at order time
  estimatedAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  idempotencyKey       String?     @unique
  crmSyncedAt          DateTime? // set once customer metrics have been counted for this order
  printQueuedAt        DateTime? // set once station print jobs have been enqueued (once-only guard)
  source               String? // pedido | qr | whatsapp | manual | import — origin channel
  importedAt           DateTime? // set for historically imported orders; actual event date
  // ── Marketing / channel attribution ──────────────────────────────────────────
  trackingLinkId       String? // FK to TrackingLink if customer arrived via trackable link
  trafficSource        String? // utm_source / e.g. instagram, whatsapp, qr, google
  trafficMedium        String? // utm_medium / e.g. bio, direct, mesa, embalagem
  trafficCampaign      String? // utm_campaign
  trafficContent       String? // utm_content
  // ── Saipos POS integration fields ────────────────────────────────────
  saiposSentAt         DateTime? // when the order was successfully sent to Saipos
  saiposOrderId        String? // Saipos internal order reference (from their response)
  saiposStatus         String? // latest status received from Saipos webhook
  saiposError          String? // last error message if send failed
  saiposLastErrorCode  String? // error code from last failed attempt (e.g. "902")
  saiposLastAttemptAt  DateTime? // timestamp of last Saipos send attempt
  // ── Coupon / promotion ────────────────────────────────────────────────
  couponCode           String? // code entered by customer at checkout
  promotionId          String? // FK to Promotion that was applied (soft reference — no CASCADE)
  couponUsageCountedAt DateTime? // set once Promotion.usedCount has been incremented for this order
  customerCouponId     String? // wallet coupon (CustomerCoupon) redeemed on this order — marked USED on payment
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id])
  orderDraft      OrderDraft?     @relation(fields: [orderDraftId], references: [id])
  deliveryAddress Address?        @relation(fields: [deliveryAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  fiscalDocument  FiscalDocument?
  editLogs        OrderEditLog[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  menuItemId   String?
  name         String // snapshot of name at order time
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  notes        String?
  total        Decimal @db.Decimal(10, 2)
  categoryId   String? // FK snapshot — stays even if category is later deleted
  categoryName String? // name snapshot at order time — stays even if category is renamed
  variantName  String? // selected variant name snapshot if applicable
  addonsJson   Json? // JSON snapshot of selected add-ons / options / customizations
  isUpsell     Boolean @default(false) // true when item was added after a Foocci upsell suggestion

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([categoryId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT // between PENDING and CONFIRMED for pay_now flows
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ═══════════════════════════════════════════
//  PAYMENTS
// ═══════════════════════════════════════════

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  // Cash change: the bill/note the customer will hand over ("troco para R$ 100").
  // null = exact change / not a cash order. Change to bring = changeFor - total.
  // Prints on the cashier ticket so the caixa knows before the order arrives.
  changeFor         Decimal?      @db.Decimal(10, 2)
  paidAt            DateTime?
  // Stone / hosted-link fields (all nullable — not used for cash/card-machine flows)
  paymentMode       PaymentMode   @default(PAY_NOW)
  providerName      String? // "stone" | "mercadopago" | "sumup" | null
  providerReference String? // provider payment/checkout id (Stone link, MP payment, SumUp checkout)
  paymentUrl        String? // hosted checkout URL / Pix copy-paste
  expiresAt         DateTime? // Stone link expiry
  // Transparent card (SumUp) result metadata — null for Pix/cash.
  installments      Int? // parcelas (1 = à vista)
  cardBrand         String? // "visa" | "master" | … (for the receipt/ticket)
  cardLast4         String? // last 4 digits (display only)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ═══════════════════════════════════════════
//  WHATSAPP SHORT MENU LINK
// ═══════════════════════════════════════════
// Short redirect code the receptionist sends instead of the long identified
// /pedido URL (a ~180-char signed waToken looked awful in WhatsApp). One stable
// code per (restaurant, customer); /r/[code] signs a fresh waToken on tap and
// 302-redirects to /pedido/[slug]. expiresAt is refreshed on every send.

model WaMenuLink {
  code         String   @id
  restaurantId String
  phone        String
  name         String?
  hits         Int      @default(0)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("wa_menu_links")
}

// ═══════════════════════════════════════════
//  ORDER EDIT LOG  (audit trail for item replacements)
// ═══════════════════════════════════════════

model OrderEditLog {
  id           String  @id @default(cuid())
  orderId      String
  restaurantId String
  userId       String? // staff member who made the change; null = system

  // What changed
  action String @default("ITEM_REPLACED")

  // Previous item snapshot
  previousItemId   String? // OrderItem.id that was removed (informational only)
  previousItemName String
  previousItemQty  Int
  previousItemData Json // { name, price, quantity, variantName, addonsJson, total }

  // New item snapshot
  newItemName String
  newItemQty  Int
  newItemData Json // { name, price, quantity, variantName, addonsJson, total }

  // Financial impact
  previousTotal Decimal @db.Decimal(10, 2) // order total before change
  newTotal      Decimal @db.Decimal(10, 2) // order total after change
  priceDiff     Decimal @db.Decimal(10, 2) // newTotal − previousTotal (positive = to collect)

  // Reason
  reason     String // CLIENTE_PEDIU | PRODUTO_INDISPONIVEL | ERRO_SABOR | ERRO_OPERACIONAL | OUTRO
  reasonNote String?

  // Payment adjustment tracking (staff must resolve manually)
  paymentResolved Boolean @default(false) // staff marked the payment diff as handled

  createdAt DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([restaurantId])
  @@map("order_edit_logs")
}

enum PaymentMode {
  PAY_NOW
  PAY_ON_DELIVERY
  PAY_ON_PICKUP
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  ONLINE
  CARD_MACHINE // physical terminal (pay on delivery/pickup)
  PIX_IN_PERSON // QR code shown at door/counter
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  LINK_SENT // Stone link sent, awaiting payment
  PAY_ON_DELIVERY // collected at delivery
  PAY_ON_PICKUP // collected at counter
  EXPIRED // Stone link expired
}

// ═══════════════════════════════════════════
//  CONVERSATIONS & MESSAGES  (Phase 3)
// ═══════════════════════════════════…77067 tokens truncated…a pessoa.
// Espremer isso em `SiteLead` obrigaria a duplicar a empresa a cada contato
// descoberto, e o score do restaurante passaria a existir em três cópias
// divergentes.
//
// ── ⚠️ ESTES MODELOS SÃO ADITIVOS. NADA FOI APAGADO, RENOMEADO OU ESVAZIADO ─
//
// `SiteLead` continua funcionando exatamente como antes: ganhou DOIS campos
// opcionais (`empresaId`, `contatoId`) e nada mais. Lead que nasce sem empresa
// — que é a maioria, e é o caminho do Meta Ads e do site — segue com os dois
// nulos e nenhuma consulta existente muda de resultado.
//
// ── MULTI-TENANT: A RESPOSTA É "NÃO TEM", E É PROPOSITAL ───────────────────
//
// Esta família inteira segue a regra escrita em `SiteLead`: é a base da FOOCCI
// vendendo para donos de restaurante, não a base de um restaurante. Não tem
// `restaurantId` porque o restaurante ainda não existe — e é exatamente essa
// ausência que impede o cruzamento. Pôr `restaurantId` aqui seria inventar um
// tenant falso dentro do sistema cuja regra número um é não misturar as bases.
// ═══════════════════════════════════════════════════════════════════════════

/// O pipeline do Hunter, na ordem do documento:
/// descoberta → enriquecendo → pronto SDR → gatekeeper → decisor encontrado →
/// qualificado.
///
/// ⚠️ `DESCARTADA` fica FORA da sequência, pelo mesmo motivo de `PERDIDO` no
/// funil do lead: uma empresa descartada SAIU do pipeline, não avançou nele.
/// Contá-la como etapa faria a conversão do Hunter mentir.
enum EstagioDaEmpresa {
  /// Achada por alguma fonte. Só existe nome e o mínimo que a fonte deu.
  DESCOBERTA
  /// Alguém (pessoa ou máquina) está completando canais, unidades e sistema.
  ENRIQUECENDO
  /// Tem ficha suficiente e ICP medido. É a fila de trabalho do SDR.
  ///
  /// ⚠️ ESTE É O TETO DA DESCOBERTA AUTOMÁTICA. Nenhuma fonte entrega empresa
  /// em fila de envio: descoberta ligada a disparo é como uma base de 8.000
  /// virar 8.000 mensagens numa tarde.
  PRONTA_PARA_SDR
  /// O SDR bateu num porteiro (bot, recepção, SAC) e está procurando a rota.
  GATEKEEPER
  /// Existe um `Contato` com `ehDecisor = true` ligado a esta empresa.
  DECISOR_ENCONTRADO
  /// O decisor conversou e tem perfil, dor e interesse. Vale virar oportunidade.
  QUALIFICADA
  /// Terminal, e fora da sequência. `motivoDoDescarte` é obrigatório.
  DESCARTADA
}

/// A leitura do ICP, separada do número pelo mesmo motivo de `LeadTemperatura`:
/// o número é o cálculo, a prioridade é a leitura.
/// **Não existe prioridade por omissão** — `null` quer dizer "ninguém priorizou".
enum PrioridadeDaEmpresa {
  ALTA
  MEDIA
  BAIXA
}

/// Quem atende o telefone e NÃO decide nada. O documento lista todos estes:
/// *"bot; recepcionista; atendente; caixa; SAC; central telefônica; formulário;
/// WhatsApp de pedidos"*.
///
/// Saber QUAL é muda a estratégia do SDR: bot de pedidos se fura com menu,
/// recepcionista se convence com transparência, formulário não se fura de jeito
/// nenhum e exige outro canal.
enum TipoDeGatekeeper {
  BOT_DE_PEDIDOS
  RECEPCIONISTA
  ATENDENTE
  SAC
  CAIXA
  FORMULARIO
  WHATSAPP_GERAL
  CENTRAL_TELEFONICA
  OUTRO
}

/// Quanto se confia no dado. Existe porque "informado pelo atendimento" e
/// "achado num diretório de 2019" não valem a mesma coisa — e quem for abordar
/// o decisor precisa saber em qual dos dois está apostando.
enum ConfiancaDaInformacao {
  ALTA
  MEDIA
  BAIXA
}

/// Os estágios da oportunidade. ORDEM IMPORTA (a conversão é calculada nela).
/// `GANHA` e `PERDIDA` são terminais e ficam fora da sequência.
enum EstagioDaOportunidade {
  DESCOBERTA
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  GANHA
  PERDIDA
}

/// A vida do cliente depois da venda. O documento é explícito:
/// *"Lead NÃO volta para o início. Ele se torna CLIENTE."*
enum SituacaoDoCliente {
  /// Comprou, ainda não está usando. É onde o churn nasce quando ninguém olha.
  EM_ATIVACAO
  ATIVO
  /// Sinal de churn detectado. Não é cancelamento — é o aviso antes dele.
  EM_RISCO
  /// Parou de usar, sem ter cancelado formalmente.
  INATIVO
  CANCELADO
}

/// A que entidade da jornada um evento pertence.
enum EntidadeDaJornada {
  EMPRESA
  CONTATO
  OPORTUNIDADE
  CLIENTE
}

/// O que aconteceu. Vocabulário deliberadamente curto: evento que não muda
/// nada nem explica nada vira ruído, e trilha ruidosa ninguém lê.
enum TipoDeEventoDaJornada {
  CRIACAO
  MUDANCA_DE_ESTAGIO
  /// Um dado novo entrou na ficha (canal, unidades, sistema, CNPJ…).
  ENRIQUECIMENTO
  /// Duas entidades foram amarradas (lead ↔ empresa, contato ↔ empresa…).
  VINCULO
  GATEKEEPER_IDENTIFICADO
  DECISOR_ENCONTRADO
  /// O ICP foi calculado (ou recalculado) — a conta fica em `EmpresaFatorIcp`.
  SCORE_CALCULADO
  NOTA
}

/// ⭐ O RESTAURANTE PROSPECTADO — o alvo do Hunter, ANTES de existir lead.
///
/// É a ficha que o documento desenha em `RESTAURANTE / Sushi House`: categoria,
/// cidade, bairro, canais encontrados, delivery, iFood, unidades, sistema,
/// ICP, prioridade, fonte e estado no pipeline.
///
/// ── DEDUPE ──────────────────────────────────────────────────────────────────
/// `chaveDeDedupe` é a única restrição de unicidade, e é assim de propósito:
/// CNPJ não vem em quase nenhuma fonte de descoberta, e telefone é da PESSOA,
/// não da casa (o mesmo número aparece em duas unidades). A chave é derivada de
/// nome+cidade+estado normalizados pelo serviço, e é o que torna "descobrir a
/// mesma empresa duas vezes" um `no-op` em vez de uma linha duplicada.
model Empresa {
  id   String @id @default(cuid())
  nome String

  /// nome+cidade+estado normalizados. Ver `jornadaComercial.chaveDeDedupeDaEmpresa`.
  chaveDeDedupe String @unique

  /// Japonesa, pizzaria, padaria, boteco… O universo já está escrito em
  /// `src/services/salaDeVendas/score.ts` e não é reinventado aqui.
  categoria String?
  cidade    String?
  estado    String?
  bairro    String?
  endereco  String?
  cep       String?
  cnpj      String?

  // ── CANAIS ENCONTRADOS ────────────────────────────────────────────────────
  // Todos opcionais e todos com PROVENIÊNCIA própria (ver `EmpresaProveniencia`):
  // saber que existe um WhatsApp publicado não diz de onde ele veio, e sem isso
  // não há como responder "por que temos o contato desta empresa?".
  site              String?
  instagram         String?
  facebook          String?
  /// O número que a empresa PUBLICA. ⚠️ Número publicado NÃO é opt-in — a trava
  /// que decide se dá para falar continua sendo `LeadContactSafety`.
  whatsappPublicado String?
  email             String?
  telefone          String?
  googleMapsUrl     String?

  // ── COMO ELA VENDE HOJE ───────────────────────────────────────────────────
  /// `null` = ninguém apurou, e é diferente de `false` ("apurado, não tem").
  /// Escrever `false` por omissão apagaria a fila de quem falta enriquecer.
  deliveryProprio      Boolean?
  /// iFood, Rappi, 99Food… Vazio significa "não apurado"; a diferença entre
  /// "vazio" e "apurado e nenhum" mora em `apuradoMarketplaceEm`.
  marketplaces         String[]  @default([])
  apuradoMarketplaceEm DateTime?
  cardapioProprio      Boolean?
  numeroDeUnidades     Int?
  /// O sistema de gestão/PDV identificado — é a dor e o concorrente ao mesmo tempo.
  sistemaIdentificado  String?
  /// Ticket médio estimado, em CENTAVOS, como todo dinheiro nesta casa.
  ticketEstimadoCents  Int?

  // ── ICP ───────────────────────────────────────────────────────────────────
  /// **`null` significa "ninguém mediu"**, e é diferente de zero, que significa
  /// "medido e não qualifica". Mesma regra de `SiteLead.score`, pelo mesmo motivo:
  /// escrever zero esconderia a fila inteira de quem nunca foi avaliado.
  scoreIcp    Int?
  scoreIcpEm  DateTime?
  /// A versão da régua que gerou o número. Sem isso, mudar os pesos reescreveria
  /// retroativamente a explicação de scores antigos.
  reguaVersao Int?
  /// `null` = não priorizada. Nunca BAIXA por omissão.
  prioridade  PrioridadeDaEmpresa?

  // ── PIPELINE HUNTER ───────────────────────────────────────────────────────
  estagio          EstagioDaEmpresa @default(DESCOBERTA)
  estagioMudouEm   DateTime         @default(now())
  /// Quem mudou por último. Espelha o último `EventoDaJornada` — a trilha é a
  /// fonte da verdade, este campo é cache da lista.
  estagioMudouPor  String?
  /// Obrigatório em DESCARTADA. Descarte sem motivo não vira relatório, e a
  /// pergunta "o que mais nos faz descartar" fica sem resposta.
  motivoDoDescarte String?

  // ── DE ONDE ELA VEIO ──────────────────────────────────────────────────────
  /// A fonte que a trouxe pela primeira vez ("planilha-outscraper", "site",
  /// "indicacao"). O detalhe campo a campo está em `proveniencias`.
  fonteDaDescoberta   String
  descobertaEm        DateTime        @default(now())
  /// IA, HUMANO ou SISTEMA — o documento exige distinguir, e a trilha inteira
  /// desta família usa o mesmo vocabulário de `LeadMensagem.autor`.
  descobertaPorAutor  AutorDaMensagem @default(SISTEMA)
  /// O id interno de quem descobriu, quando foi gente. Sem chave estrangeira
  /// de propósito: uma FK obrigaria a alterar `InternalUser`, que é model vivo.
  descobertaPorUserId String?

  /// O lote/importação que trouxe esta empresa, quando veio de planilha.
  /// Sem FK pelo mesmo motivo: `LoteDeProspeccao` é model vivo e não ganha
  /// relação de volta neste bloco.
  loteDeProspeccaoId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contatos      Contato[]
  oportunidades Oportunidade[]
  clientes      Cliente[]
  leads         SiteLead[]
  fatoresIcp    EmpresaFatorIcp[]
  proveniencias EmpresaProveniencia[]
  eventos       EventoDaJornada[]

  @@index([estagio, estagioMudouEm])
  @@index([prioridade, scoreIcp])
  @@index([cidade, estado])
  @@index([categoria])
  @@index([cnpj])
  @@index([loteDeProspeccaoId])
  @@map("empresas")
}

/// A CONTA do ICP, fator a fator — irmão gêmeo de `LeadScoreFator`, e pelo
/// mesmo motivo do item 10 do comando: *"não utilizar uma pontuação opaca sem
/// explicação"*. Número que ninguém consegue contestar é número que o time
/// aprende a ignorar.
model EmpresaFatorIcp {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// Chave estável da regra (`unidades`, `marketplace`, `sistema`…).
  fator       String
  /// O que foi observado, em texto legível ("2 unidades", "só iFood").
  observado   String
  pontos      Int
  reguaVersao Int

  criadoEm DateTime @default(now())

  @@index([empresaId, criadoEm])
  @@index([fator])
  @@map("empresa_fatores_icp")
}

/// ⭐ PROVENIÊNCIA CAMPO A CAMPO — *"registrar origem/proveniência dos dados"*.
///
/// Uma linha por dado apurado. Existe porque "a empresa veio do Outscraper" não
/// responde "de onde veio ESTE telefone": a ficha se forma por camadas, e cada
/// camada tem fonte, data, autor e confiança diferentes. No dia da dúvida — e
/// numa base fria B2B ele chega — a resposta tem de ser por campo.
///
/// Append-only: apurar de novo cria linha nova. A última por `coletadoEm` é a
/// que vale, e as anteriores continuam provando o que se sabia antes.
model EmpresaProveniencia {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// O nome do campo da ficha ("whatsappPublicado", "numeroDeUnidades"…).
  campo     String
  /// O valor como foi apurado, em texto. Não é o campo — é a prova dele.
  valor     String?
  /// De onde saiu ("google-maps", "site-oficial", "instagram", "planilha").
  fonte     String
  /// O endereço exato, quando existe. É o que permite conferir sem refazer.
  url       String?
  confianca ConfiancaDaInformacao @default(MEDIA)

  coletadoEm        DateTime        @default(now())
  coletadoPorAutor  AutorDaMensagem @default(SISTEMA)
  coletadoPorUserId String?

  @@index([empresaId, campo, coletadoEm])
  @@index([fonte])
  @@map("empresa_proveniencias")
}

/// ⭐ UMA PESSOA LIGADA À EMPRESA — e a resposta para a palavra que não existia
/// no banco: DECISOR.
///
/// ── POR QUE NÃO É UM `SiteLead` ───────────────────────────────────────────
/// `SiteLead` é um RELACIONAMENTO COMERCIAL (tem funil, SLA, consentimento,
/// conversa). Um contato descoberto é só uma pessoa conhecida — a recepcionista
/// que informou o nome da gerente não tem funil, não tem SLA e não pode receber
/// abordagem. Criar lead para cada pessoa encontrada encheria a fila de trabalho
/// com porteiros.
///
/// Quando o decisor aceita conversar, aí sim nasce (ou se liga) um `SiteLead`,
/// e o campo `SiteLead.contatoId` amarra os dois.
model Contato {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nome  String
  cargo String?

  /// Por onde se fala com esta pessoa ("whatsapp", "telefone", "email",
  /// "instagram"). Texto e não enum: o canal muda mais rápido que o schema.
  canal          String?
  telefone       String?
  /// Só dígitos, no MESMO formato de `SiteLead.whatsappDigits` — é por ele que
  /// o serviço reconhece que este contato já virou lead.
  telefoneDigits String?
  email          String?

  // ── DECISOR OU PORTEIRO ───────────────────────────────────────────────────
  /// `true` = decide ou influencia a compra. **`false` não quer dizer porteiro**:
  /// quer dizer "não é decisor", que inclui quem ninguém classificou ainda.
  ehDecisor        Boolean           @default(false)
  ehGatekeeper     Boolean           @default(false)
  /// Só preenchido quando `ehGatekeeper = true`.
  tipoDeGatekeeper TipoDeGatekeeper?

  confianca         ConfiancaDaInformacao @default(MEDIA)
  /// COMO se soube ("informado pelo atendimento", "assinatura do site",
  /// "perfil do Instagram"). É a frase que o vendedor lê antes de abrir a boca.
  comoFoiDescoberto String?
  fonte             String?

  // ── CONSENTIMENTO ─────────────────────────────────────────────────────────
  // Mesmo contrato de `SiteLead`: `null` é BLOQUEIO, nunca presunção. Nada aqui
  // autoriza envio — quem autoriza continua sendo `LeadContactSafety`, sobre o
  // lead. Estes campos só carregam a prova para quando ela existir.
  consentimentoEm       DateTime?
  consentimentoCanal    String?
  consentimentoPolitica String?
  optOutEm              DateTime?

  criadoEm        DateTime        @default(now())
  criadoPorAutor  AutorDaMensagem @default(SISTEMA)
  criadoPorUserId String?
  atualizadoEm    DateTime        @updatedAt

  leads         SiteLead[]
  oportunidades Oportunidade[]
  eventos       EventoDaJornada[]

  /// A mesma pessoa não entra duas vezes na mesma empresa pelo mesmo telefone.
  /// ⚠️ Parcial por natureza: contato sem telefone não é deduplicado por aqui —
  /// e é melhor duplicar um contato sem telefone do que recusar um decisor cujo
  /// número ainda não se conhece.
  @@unique([empresaId, telefoneDigits])
  @@index([empresaId, ehDecisor])
  @@index([telefoneDigits])
  @@index([ehGatekeeper, tipoDeGatekeeper])
  @@map("contatos_de_empresa")
}

/// ⭐ A OPORTUNIDADE — o negócio em si, que hoje não existe em lugar nenhum.
///
/// ── POR QUE NÃO É O `SiteLeadStage` ───────────────────────────────────────
/// O funil do lead responde "em que pé está a CONVERSA com esta pessoa". A
/// oportunidade responde "quanto vale este NEGÓCIO e o que falta para fechar".
/// São contas diferentes: a mesma empresa pode ter duas oportunidades (as duas
/// unidades, ou uma perdida em março e outra aberta em setembro), e um funil por
/// pessoa nunca soube contar isso.
///
/// ⚠️ O funil do lead NÃO foi tocado. `SiteLeadStage` continua com as 13 etapas
/// e todas as telas que o consomem seguem iguais.
model Oportunidade {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// O decisor. Opcional porque existe oportunidade que nasce de um lead de
  /// entrada (Meta Ads), onde a empresa foi descoberta DEPOIS da pessoa.
  contatoDecisorId String?
  contatoDecisor   Contato? @relation(fields: [contatoDecisorId], references: [id], onDelete: SetNull)

  /// O lead que conduz a conversa desta oportunidade, quando há um.
  leadId String?
  lead   SiteLead? @relation("OportunidadeDoLead", fields: [leadId], references: [id], onDelete: SetNull)

  /// ⭐ A chave da idempotência. O serviço a deriva da origem do pedido
  /// (empresa + contato + motivo), e é ela que faz "criar a oportunidade duas
  /// vezes" devolver a mesma linha em vez de abrir duas negociações.
  chaveDeOrigem String? @unique

  /// Em CENTAVOS. `null` = ninguém estimou — nunca zero por omissão.
  valorPotencialCents Int?
  /// O que ele quer comprar ("CRM", "cardápio próprio", "plano completo").
  produtoDeInteresse  String?

  estagio         EstagioDaOportunidade @default(DESCOBERTA)
  estagioMudouEm  DateTime              @default(now())
  estagioMudouPor String?

  /// 0 a 100. `null` = não estimada.
  probabilidade Int?

  /// A dor que sustenta a venda ("80% do faturamento no iFood").
  dorIdentificada String?
  /// As objeções ouvidas, uma por linha da lista. Vazio = nenhuma registrada.
  objecoes        String[] @default([])

  /// Só em PERDIDA, e OBRIGATÓRIO: reusa o catálogo `MotivoDePerda` que já
  /// existe para o lead, em vez de criar um segundo catálogo divergente.
  motivoPerdaId      String?
  motivoPerda        MotivoDePerda? @relation("MotivoDaOportunidade", fields: [motivoPerdaId], references: [id])
  /// O detalhe, quando o motivo exige. Nunca substitui o motivo estruturado.
  motivoPerdaDetalhe String?

  previsaoDeFechamento DateTime?
  fechadaEm            DateTime?

  criadoEm        DateTime        @default(now())
  criadoPorAutor  AutorDaMensagem @default(SISTEMA)
  criadoPorUserId String?
  atualizadoEm    DateTime        @updatedAt

  cliente Cliente?
  eventos EventoDaJornada[]

  @@index([estagio, estagioMudouEm])
  @@index([empresaId, estagio])
  @@index([leadId])
  @@index([previsaoDeFechamento])
  @@index([motivoPerdaId])
  @@map("oportunidades")
}

/// ⭐ O CLIENTE — nasce quando a oportunidade é GANHA, e não antes.
///
/// O documento é explícito: *"Lead NÃO volta para o início. Ele se torna
/// CLIENTE."* Hoje GANHO é o fim da linha do comercial e ninguém mede o que
/// acontece depois — ativação, saúde, recompra e churn não existiam nesta base.
///
/// ── IDEMPOTÊNCIA POR CONSTRUÇÃO ───────────────────────────────────────────
/// `oportunidadeId` é ÚNICO. Ganhar a mesma oportunidade duas vezes não pode
/// criar dois clientes, e a garantia é do banco — não da ordem das chamadas.
///
/// ⚠️ NÃO confundir com `Restaurant` (o tenant do produto) nem com
/// `PlanSubscription` (o contrato e o dinheiro). Este model é a SAÚDE da conta
/// do ponto de vista comercial. `restaurantId` fica aqui como ponteiro opcional
/// e SEM chave estrangeira: a conta do produto pode ser provisionada dias depois
/// da venda, e o comercial não espera por ela.
model Cliente {
  id String @id @default(cuid())

  oportunidadeId String       @unique
  oportunidade   Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// O tenant do produto, quando já existir. Ponteiro solto de propósito.
  restaurantId String?

  situacao         SituacaoDoCliente @default(EM_ATIVACAO)
  situacaoMudouEm  DateTime          @default(now())
  situacaoMudouPor String?

  ganhoEm DateTime @default(now())

  // ── ATIVAÇÃO ──────────────────────────────────────────────────────────────
  /// Quando começou de fato a usar. `null` = comprou e ainda não ligou — que é
  /// o estado onde o churn nasce.
  ativadoEm        DateTime?
  /// Os passos de ativação concluídos ("cardápio publicado", "WhatsApp ligado").
  passosDeAtivacao String[]  @default([])

  // ── SAÚDE ─────────────────────────────────────────────────────────────────
  /// 0 a 100. `null` = não medida. Nunca zero por omissão — zero aqui
  /// significaria "conta morta" e mandaria o time atrás de quem ninguém olhou.
  saude         Int?
  saudeEm       DateTime?
  /// 0 a 10, a nota crua do NPS. `null` = não respondeu.
  nps           Int?
  npsEm         DateTime?
  /// `null` = não medido. Preenchido = a conta está em risco e o motivo explica.
  riscoDeChurn  Int?
  motivoDoRisco String?

  // ── RECEITA DEPOIS DA PRIMEIRA VENDA ──────────────────────────────────────
  ultimaCompraEm    DateTime?
  recompras         Int       @default(0)
  upsells           Int       @default(0)
  /// Soma do que já entrou por esta conta, em CENTAVOS.
  receitaTotalCents Int       @default(0)

  canceladoEm          DateTime?
  motivoDoCancelamento String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  eventos EventoDaJornada[]

  @@index([situacao, situacaoMudouEm])
  @@index([empresaId])
  @@index([riscoDeChurn])
  @@index([restaurantId])
  @@map("clientes_comerciais")
}

/// ⭐ A TRILHA DA JORNADA — append-only, e ela acompanha o registro.
///
/// ── POR QUE NÃO É `SiteLeadInteraction` ───────────────────────────────────
///
/// Foi a primeira coisa que tentei, e não cabe: `SiteLeadInteraction.leadId` é
/// OBRIGATÓRIO e tem cascade para `SiteLead`. Uma empresa descoberta pelo Hunter
/// não tem lead — e a maior parte da vida dela acontece antes de existir um. Para
/// reusar aquela tabela seria preciso afrouxar uma coluna viva que os testes, dois
/// índices e toda a tela da ficha assumem preenchida. **Não afrouxo coluna viva
/// para caber.**
///
/// O que se reusa é o CONTRATO, não a tabela: mesmo formato de `actor`/`nota`/
/// `interna`, mesma regra de append-only, mesmo vocabulário de autoria
/// (`AutorDaMensagem`). Quem lê as duas lê a mesma gramática.
///
/// ⚠️ `SiteLeadInteraction` continua sendo a linha do tempo DO LEAD, intocada.
/// Esta é a linha do tempo da JORNADA. A ficha do vendedor junta as duas pela
/// ordem do relógio — nada foi movido de uma para a outra.
model EventoDaJornada {
  id String @id @default(cuid())

  /// Qual entidade este evento descreve. Redundante com as chaves abaixo de
  /// propósito: é por ele que a consulta filtra sem varrer quatro colunas.
  entidade   EntidadeDaJornada
  /// O id da entidade acima, repetido para consulta direta.
  entidadeId String

  empresaId      String?
  empresa        Empresa?      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contatoId      String?
  contato        Contato?      @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  oportunidadeId String?
  oportunidade   Oportunidade? @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  clienteId      String?
  cliente        Cliente?      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  /// O lead envolvido, quando há um. Sem cascade e sem relação de volta: apagar
  /// um lead não pode apagar a história da EMPRESA.
  leadId         String?

  tipo TipoDeEventoDaJornada

  /// Preenchidos só em MUDANCA_DE_ESTAGIO. Texto e não enum porque a mesma
  /// tabela guarda estágio de empresa, de oportunidade e de cliente — três enums
  /// diferentes. O rótulo vem do serviço.
  deEstagio   String?
  paraEstagio String?

  /// IA, HUMANO ou SISTEMA. O documento exige distinguir: *"ações da IA vs
  /// humano"*. É o campo que responde "quem decidiu isto?".
  autor       AutorDaMensagem
  /// O id interno, quando foi gente. Sem FK: não altera `InternalUser`.
  autorUserId String?
  /// Rótulo legível de quem agiu, congelado no evento — mesma doutrina de
  /// `InternalAuditEvent.actorLabel`: se a pessoa sair, o histórico continua
  /// dizendo quem foi.
  autorLabel  String?

  /// O porquê. Em MUDANCA_DE_ESTAGIO é o que explica o movimento; em
  /// ENRIQUECIMENTO é de onde o dado veio.
  motivo String?
  nota   String?
  /// De onde o dado veio, quando o evento trouxe dado ("google-maps", "site").
  fonte  String?

  /// `true` = nunca sai para o cliente. Mesma regra de `SiteLeadInteraction`.
  interna Boolean @default(true)

  /// ⭐ A chave da idempotência da trilha. Quando preenchida, a mesma ação não
  /// grava dois eventos — é o que permite reprocessar uma rodada inteira sem
  /// inflar a história. `null` = evento livre (nota manual), que pode repetir.
  chaveDeIdempotencia String? @unique

  criadoEm DateTime @default(now())

  @@index([entidade, entidadeId, criadoEm])
  @@index([empresaId, criadoEm])
  @@index([oportunidadeId, criadoEm])
  @@index([clienteId, criadoEm])
  @@index([leadId, criadoEm])
  @@index([tipo, criadoEm])
  @@index([autor, criadoEm])
  @@map("jornada_eventos")
}

// ═══════════════════════════════════════════════════════════════════════════
// A TRAVA DE REPETIÇÃO — 17/09/2026
//
// Medido no banco de produção: 21 de 200 conversas receberam a MESMA mensagem
// nossa repetida; dois restaurantes receberam o mesmo texto 16 vezes.
//
// A causa é de desenho: todo o caminho de saída LÊ o estado do lead e só
// DEPOIS escreve. Duas rodadas simultâneas leem o mesmo zero e mandam as duas.
// Estas três tabelas existem para que a pergunta "já mandamos isto para este
// número?" seja respondida pelo BANCO, atomicamente, e não por um `if`.
//
// Ver `src/services/salaDeVendas/travaDeRepeticao.ts`.
// ═══════════════════════════════════════════════════════════════════════════

/// Uma linha por NÚMERO: quando saiu a última abordagem nossa.
///
/// A chave é o telefone, e não o lead, de propósito: a base tem leads
/// duplicados para a mesma pessoa, e uma trava por lead não veria a segunda
/// mensagem saindo pela segunda ficha.
model TravaDeAbordagemRitmo {
  telefoneDigits String   @id
  ultimoEnvioEm  DateTime

  @@map("trava_abordagem_ritmo")
}

/// Uma linha por (número, conteúdo). O `@@unique` é a trava: a segunda
/// gravação do mesmo conteúdo para o mesmo número é recusada pelo Postgres.
model TravaDeAbordagemEnviada {
  id             String   @id @default(cuid())
  telefoneDigits String
  /// sha256 do conteúdo normalizado (espaço colapsado, minúsculas).
  impressao      String
  leadId         String?
  /// De onde veio a tentativa ("abordar.ts", "entrega.ts"…).
  origem         String
  criadoEm       DateTime @default(now())

  @@unique([telefoneDigits, impressao])
  @@index([telefoneDigits, criadoEm])
  @@map("trava_abordagem_enviada")
}

/// Toda recusa da trava, escrita. Sem isto ela seria silêncio — o mesmo
/// defeito que ela veio consertar, com o sinal trocado.
model TravaDeAbordagemRecusa {
  id             String   @id @default(cuid())
  telefoneDigits String
  impressao      String
  leadId         String?
  origem         String
  /// `conteudoJaEnviado`, `intervaloMinimo`, `semTelefone`, `bancoIndisponivel`.
  motivo         String
  detalhe        String
  criadoEm       DateTime @default(now())

  @@index([criadoEm])
  @@index([telefoneDigits, criadoEm])
  @@index([motivo, criadoEm])
  @@map("trava_abordagem_recusa")
}

/// O FUNIL DE UM CICLO DE CAMPANHA DO CRM DO RESTAURANTE.
///
/// Existe por um motivo só: fazer a conta do dia FECHAR. Quem é cortado antes de
/// virar linha em `campaign_executions` (o excedente do teto por rodada) não
/// deixava rastro nenhum, e sem esse número a invariante
/// `enviados + barrados + cortados = elegíveis` nunca podia ser provada.
///
/// Somente medição. Nada aqui gateia envio — não é trava, é régua.
model CrmCicloFunil {
  id           String   @id @default(cuid())
  restaurantId String
  campaignId   String
  ocorridoEm   DateTime @default(now())

  /// Quantos sobreviveram a TODAS as exclusões e foram oferecidos a este ciclo.
  elegiveis Int
  /// Quantos entraram no lote de fato enviado.
  noLote Int
  /// elegiveis − noLote: o grupo que sumia sem rastro.
  cortados Int
  /// Qual teto cortou: TETO_DA_RODADA / LIMITE_DIARIO_DA_CAMPANHA / ORCAMENTO_DO_CICLO.
  motivoDoCorte String?
  /// O teto por rodada aplicado, para a conta poder ser refeita depois.
  tetoDaRodada Int @default(0)

  @@index([restaurantId, ocorridoEm])
  @@index([campaignId, ocorridoEm])
  @@map("crm_ciclo_funil")
}

// ═══════════════════════════════════════════════════════════════════════════
// A REABORDAGEM DOS CONTATOS FRIOS — o interruptor e a conta
// ═══════════════════════════════════════════════════════════════════════════

/// O INTERRUPTOR DE PÂNICO da campanha de reabordagem.
///
/// Uma linha só (`id = "unico"`). `paradoEm` preenchido = **parada total**, e a
/// máquina confere esta linha ANTES DE CADA CONTATO — não uma vez por lote. É
/// por isso que ele funciona com lote em andamento: o lote não é atômico, ele é
/// uma sequência, e cada passo pergunta de novo.
///
/// ⚠️ Fail-closed: se a leitura desta linha falhar, a máquina PARA. Não saber se
/// mandaram parar é a mesma coisa que ter mandado parar.
model ReabordagemInterruptor {
  id           String    @id
  paradoEm     DateTime?
  motivo       String?
  quemParou    String?
  atualizadoEm DateTime  @updatedAt

  @@map("reabordagem_interruptor")
}

/// UMA LINHA POR CONTATO EXAMINADO, em cada lote. É a conta que fecha.
///
/// Todo candidato que entra no lote sai daqui com uma linha — enviado, recusado
/// ou separado para revisão —, com a REGRA que decidiu. Sem isto, "750 entraram
/// e 312 saíram" seria um número sem conferência possível.
///
/// `@@unique([loteId, leadId])` é trava, não enfeite: o mesmo contato não é
/// processado duas vezes dentro do mesmo lote, nem por duas execuções
/// simultâneas — a segunda gravação é recusada pelo Postgres.
model ReabordagemExecucao {
  id     String @id @default(cuid())
  loteId String
  leadId String

  /// A ação decidida pela rota de decisão (`reabordagem/rota.ts`).
  acao   String
  /// `JANELA` (texto livre dentro das 24h) ou `TEMPLATE` (fora dela), ou `NENHUM`.
  canal  String

  enviado    Boolean @default(false)
  mensagemId String?

  /// Por qual REGRA não saiu. Enumerado pela rota; nunca texto solto.
  motivoDaRecusa String?
  detalhe        String? @db.Text

  /// ⭐ A MÉTRICA DA CAMPANHA. Não é "mensagens enviadas": é isto.
  decisorCapturado Boolean @default(false)
  /// O lead novo aberto para o decisor indicado, quando houve.
  leadDoDecisorId  String?

  criadoEm DateTime @default(now())

  @@unique([loteId, leadId])
  @@index([criadoEm])
  @@index([acao, criadoEm])
  @@index([loteId])
  @@map("reabordagem_execucao")
}

// ═══════════════════════════════════════════════════════════════════════════
// ⭐ ARQUIVO MORTO DAS CONVERSAS — a cópia que se grava ANTES de apagar
// ═══════════════════════════════════════════════════════════════════════════
//
// A limpeza de 18/09/2026 (ordem do CEO) apaga as conversas de atendimento e
// mantém os contatos. Apagar sem cópia é irreversível: no dia em que um
// restaurante reclamar do que foi dito a ele, a resposta não pode ser "não sei".
//
// Esta tabela é de LEITURA. Nada no produto escreve nela fora da limpeza, e
// nada lê dela em caminho de atendimento — ela existe para consulta humana:
//
//   SELECT ocorreu_em, direcao, autor, texto
//     FROM conversas_arquivadas
//    WHERE lead_whatsapp_digits = '5511...'
//    ORDER BY ocorreu_em;
//
// `id` é o MESMO id da `LeadMensagem` original, de propósito: é o que torna a
// cópia idempotente (rodar duas vezes não duplica) e o que permite casar uma
// linha arquivada com qualquer referência antiga que tenha sobrado em log.
model ConversaArquivada {
  /// O id original da `lead_mensagens`. Não é gerado aqui.
  id     String @id
  leadId String

  /// Cópia do contato no momento do arquivamento. A ficha do lead continua viva
  /// em `site_leads`, mas ela MUDA — o arquivo guarda o que valia no dia.
  leadNome           String?
  leadWhatsapp       String?
  leadWhatsappDigits String?
  leadCodigo         String?

  direcao      String
  tipo         String
  status       String
  autor        String?
  autorUserId  String?
  waMessageId  String?
  templateNome String?
  texto        String? @db.Text
  legenda      String? @db.Text

  turnoId       String?
  papelDoAgente String?
  origemDaFala  String?

  ocorreuEm    DateTime
  criadaEm     DateTime
  arquivadaEm  DateTime @default(now())
  /// O lote da limpeza que arquivou esta linha. É o que torna a operação
  /// retomável e auditável: "o que saiu na execução X?" tem resposta.
  loteDaLimpeza String

  @@index([leadId, ocorreuEm])
  @@index([leadWhatsappDigits, ocorreuEm])
  @@index([loteDaLimpeza])
  @@map("conversas_arquivadas")
}

/// ⛔ O LEAD DA META QUE CHEGOU MAS AINDA NÃO PÔDE NASCER.
///
/// O evento `leadgen` do webhook traz só o `leadgen_id` — os dados da pessoa
/// ficam na Graph API e precisam ser buscados. Quando essa busca falha (token
/// de página ausente, Graph fora do ar, limite de chamadas), responder 200 e
/// seguir em frente perderia o lead PARA SEMPRE: a Meta considera entregue.
///
/// Então o `leadgen_id` é gravado aqui, e a rodada de reprocessamento tenta de
/// novo. Uma linha nesta tabela com `resolvidoEm` nulo é um lead pago que a
/// casa sabe que existe e ainda não conseguiu atender — é alarme, não log.
model MetaLeadPendente {
  id         String  @id @default(cuid())
  /// A chave da idempotência, a MESMA que `importarMetaLead` usa.
  leadgenId  String  @unique
  pageId     String?
  formId     String?
  /// O `created_time` do evento (epoch em segundos), preservado como veio.
  criadoNaMeta String?
  tentativas Int     @default(0)
  ultimoErro String? @db.Text
  ultimaTentativaEm DateTime?
  /// Preenchido quando o lead finalmente nasceu. Nulo = ainda pendente.
  resolvidoEm DateTime?
  /// O `SiteLead` que nasceu deste pendente, quando nasceu.
  leadId      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([resolvidoEm, createdAt])
  @@map("meta_lead_pendentes")
}

/// ⭐ A META DE RECEITA DO COMERCIAL — **um valor por mês**, nunca um só valor.
///
/// ── POR QUE UMA LINHA POR COMPETÊNCIA, E NÃO UM `singleton` ─────────────────
///
/// O padrão da casa para configuração é `id @default("singleton")`
/// (`SupervisoraConfig`, `ProspeccaoConfig`). Aqui ele seria errado: meta é um
/// número que só significa alguma coisa **dentro de um mês**. Com uma linha só,
/// mudar a meta de outubro reescreveria o que setembro cobrava — e o "80% da
/// meta" de setembro mudaria sozinho, depois do mês fechado, sem ninguém ter
/// mexido em setembro. Percentual que muda para trás não é medição: é história
/// reescrita.
///
/// Por isso a chave é a competência (`AAAA-MM`), e cada mês guarda a própria
/// decisão, com quem a tomou e quando.
///
/// ⛔ Meta é o número que o CEO DIGITA. Não existe, e não pode passar a existir
/// a partir daqui, nenhuma **previsão** de receita: previsão seria conta nossa
/// sobre o futuro, e ela sairia desta tabela parecendo medição.
model MetaDeReceitaMensal {
  id String @id @default(cuid())

  /// `AAAA-MM` — o mês a que esta meta pertence. Texto, e não data, porque o
  /// que se guarda é uma competência, não um instante: `2026-09` não tem fuso.
  competencia String @unique

  /// Em centavos, como todo dinheiro nesta casa (`valorMensalCent`).
  valorCentavos Int

  /// Quem decidiu, em id e em nome. O id é a prova; o nome é o que a tela
  /// mostra sem precisar de um join para dizer "quem trocou por último".
  definidoPorId   String?
  definidoPorNome String

  criadaEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  historico MetaDeReceitaHistorico[]

  @@map("meta_de_receita_mensal")
}

/// Toda troca de meta, com valor anterior, valor novo, quem e quando.
/// Mesmo molde de `SupervisoraModoHistorico`: decisão de dinheiro sem trilha é
/// decisão que ninguém consegue explicar três meses depois.
model MetaDeReceitaHistorico {
  id     String              @id @default(cuid())
  metaId String
  meta   MetaDeReceitaMensal @relation(fields: [metaId], references: [id], onDelete: Cascade)

  /// Repetida aqui de propósito: a trilha continua legível mesmo que a linha da
  /// meta seja apagada um dia.
  competencia String

  /// Nulo = esta foi a primeira meta desta competência.
  valorAnteriorCentavos Int?
  valorNovoCentavos     Int

  alteradoPorId   String?
  alteradoPorNome String
  motivo          String?  @db.Text
  alteradoEm      DateTime @default(now())

  @@index([competencia, alteradoEm])
  @@map("meta_de_receita_historico")
}
