// ─────────────────────────────────────────────────────────────
//  CRM Restaurante – Prisma Schema
//  Phase 2: OrderDraft, OrderDraftItem, FulfillmentType, OrderDraftStatus.
//  Phase 3: EvolutionConfig, Conversation.lastMessageAt/unreadCount,
//           Message.externalMessageId/externalStatus.
//  Phase 4: RestaurantBrandConfig (AI brand voice),
//           AIInteractionLog.toolCalls/turnNumber/estimatedCostUsd.
// ─────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════
//  TENANT – RESTAURANT
// ═══════════════════════════════════════════

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  phone       String?
  email       String?
  logoUrl     String?
  address     String?
  description String?
  timezone    String   @default("America/Sao_Paulo")
  isActive    Boolean  @default(true)
  plan        Plan     @default(STARTER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  customers        Customer[]
  menuCategories   MenuCategory[]
  orders           Order[]
  orderDrafts      OrderDraft[]
  campaigns        Campaign[]
  conversations    Conversation[]
  offers           Offer[]
  customerSegments CustomerSegment[]
  aiLogs           AIInteractionLog[]
  evolutionConfig  EvolutionConfig?
  brandConfig      RestaurantBrandConfig?
  agentConfig      WhatsAppAgentConfig?
  deliveryConfig   DeliveryConfig?
  businessHours    BusinessHours[]
  paymentSettings  PaymentSettings?
  storePolicies    StorePolicies?

  @@map("restaurants")
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

// ═══════════════════════════════════════════
//  USERS
// ═══════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String
  password     String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([email, restaurantId])
  @@index([restaurantId])
  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

// ═══════════════════════════════════════════
//  CUSTOMERS
// ═══════════════════════════════════════════

model Customer {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  phone        String    // E.164 format – WhatsApp identifier
  email        String?
  birthDate    DateTime?
  notes        String?
  totalOrders  Int       @default(0)
  totalSpend   Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderAt  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant     Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses      Address[]
  orders         Order[]
  orderDrafts    OrderDraft[]
  conversations  Conversation[]
  preferences    CustomerPreference?
  segmentMembers CustomerSegmentMembership[]

  @@unique([phone, restaurantId])
  @@index([restaurantId])
  @@map("customers")
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderDrafts OrderDraft[] // drafts referencing this address
  orders      Order[]      // orders referencing this address

  @@index([customerId])
  @@map("addresses")
}

model CustomerPreference {
  id           String   @id @default(cuid())
  customerId   String   @unique
  dietary      String[]
  allergies    String[]
  favoriteDish String?
  notes        String?
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

// ═══════════════════════════════════════════
//  MENU
// ═══════════════════════════════════════════

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  imageUrl     String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  isAvailable    Boolean    @default(true)   // false = category temporarily unavailable (does not modify item flags)
  showInDelivery Boolean    @default(true)   // false = category hidden from delivery channel
  showInDineIn   Boolean    @default(true)   // false = category hidden from QR dine-in menu
  source         MenuSource @default(MANUAL) // tracks whether created manually or via external integration
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  // Availability + channel control
  isAvailable    Boolean @default(true)  // false = temporarily sold out (shown as Indisponível)
  showInDelivery Boolean @default(true)  // false = hidden from Foocci ordering channel
  showInDineIn   Boolean @default(true)  // false = hidden from QR dine-in menu
  hasVariants    Boolean @default(false) // true = must select a variant before add-to-cart
  code        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category        MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  orderDraftItems OrderDraftItem[]
  variants        MenuItemVariant[]
  extras          MenuItemExtra[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id          String   @id @default(cuid())
  menuItemId  String
  name        String                     // e.g. "350ml", "600ml", "2L"
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

// ═══════════════════════════════════════════
//  ORDER DRAFTS  (mutable cart before confirmation)
// ═══════════════════════════════════════════

model OrderDraft {
  id                String           @id @default(cuid())
  restaurantId      String
  customerId        String
  conversationId    String?          // nullable – set when draft originates from WhatsApp (Phase 3)
  status            OrderDraftStatus @default(OPEN)
  fulfillmentType   FulfillmentType  @default(DELIVERY)
  deliveryAddressId String?          // FK to Address; null for PICKUP/DINE_IN
  subtotal          Decimal          @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal          @default(0) @db.Decimal(10, 2)
  notes             String?
  aiSummary         String?          // Phase 3: AI-generated order summary
  confirmedAt       DateTime?
  abandonedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id])
  deliveryAddress Address?        @relation(fields: [deliveryAddressId], references: [id])
  items           OrderDraftItem[]
  order           Order?          // populated after confirmation

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@map("order_drafts")
}

model OrderDraftItem {
  id           String   @id @default(cuid())
  orderDraftId String
  menuItemId   String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2) // snapshot of price at time of add
  isUpsell     Boolean  @default(false)    // true if suggested by AI upsell (Phase 3)
  notes        String?
  addedAt      DateTime @default(now())

  orderDraft OrderDraft @relation(fields: [orderDraftId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])

  @@index([orderDraftId])
  @@map("order_draft_items")
}

enum OrderDraftStatus {
  OPEN
  CONFIRMED
  ABANDONED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ═══════════════════════════════════════════
//  ORDERS  (immutable after confirmation)
// ═══════════════════════════════════════════

model Order {
  id                String      @id @default(cuid())
  restaurantId      String
  customerId        String
  orderDraftId      String?     @unique // traceability back to originating draft
  status            OrderStatus @default(PENDING)
  type              OrderType   @default(DELIVERY)
  subtotal          Decimal     @db.Decimal(10, 2)
  deliveryFee       Decimal     @default(0) @db.Decimal(10, 2)
  discount          Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  notes             String?
  deliveryAddressId String?     // FK to Address snapshot at order time
  estimatedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer   @relation(fields: [customerId], references: [id])
  orderDraft      OrderDraft? @relation(fields: [orderDraftId], references: [id])
  deliveryAddress Address?   @relation(fields: [deliveryAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  name       String  // snapshot of name at order time
  price      Decimal @db.Decimal(10, 2)
  quantity   Int
  notes      String?
  total      Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT  // between PENDING and CONFIRMED for pay_now flows
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ═══════════════════════════════════════════
//  PAYMENTS
// ═══════════════════════════════════════════

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  paidAt            DateTime?
  // Stone / hosted-link fields (all nullable — not used for cash/card-machine flows)
  paymentMode       PaymentMode   @default(PAY_NOW)
  providerName      String?       // "stone" | null
  providerReference String?       // Stone payment ID
  paymentUrl        String?       // hosted checkout URL
  expiresAt         DateTime?     // Stone link expiry
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMode {
  PAY_NOW
  PAY_ON_DELIVERY
  PAY_ON_PICKUP
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  ONLINE
  CARD_MACHINE    // physical terminal (pay on delivery/pickup)
  PIX_IN_PERSON   // QR code shown at door/counter
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  LINK_SENT       // Stone link sent, awaiting payment
  PAY_ON_DELIVERY // collected at delivery
  PAY_ON_PICKUP   // collected at counter
  EXPIRED         // Stone link expired
}

// ═══════════════════════════════════════════
//  CONVERSATIONS & MESSAGES  (Phase 3)
// ═══════════════════════════════════════════

model Conversation {
  id            String             @id @default(cuid())
  restaurantId  String
  customerId    String
  channel       Channel            @default(WHATSAPP)
  status        ConversationStatus @default(OPEN)
  assignedTo    String?
  resolvedAt    DateTime?
  lastMessageAt DateTime?          // updated on every new message; used for inbox sort
  unreadCount   Int                @default(0) // denormalized; reset when agent marks read
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id])
  messages   Message[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@index([restaurantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String      @id @default(cuid())
  conversationId    String
  direction         Direction   @default(INBOUND)
  content           String
  type              MessageType @default(TEXT)
  mediaUrl          String?
  isRead            Boolean     @default(false)
  sentAt            DateTime    @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  errorMessage      String?
  metadata          Json?
  // Phase 3: explicit external identifiers for idempotency and status tracking
  externalMessageId String?     @unique // Evolution API / WhatsApp message ID
  externalStatus    String?             // sent | delivered | read | failed

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum Channel {
  WHATSAPP
  EMAIL
  SMS
}

enum ConversationStatus {
  OPEN
  BOT
  HUMAN
  RESOLVED
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
}

// ═══════════════════════════════════════════
//  CAMPAIGNS  (Phase 3)
// ═══════════════════════════════════════════

model Campaign {
  id           String         @id @default(cuid())
  restaurantId String
  name         String
  message      String
  segmentId    String?
  scheduledAt  DateTime?
  sentAt       DateTime?
  status       CampaignStatus @default(DRAFT)
  totalSent    Int            @default(0)
  totalRead    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  segment    CustomerSegment?   @relation(fields: [segmentId], references: [id])
  executions CampaignExecution[]

  @@index([restaurantId])
  @@map("campaigns")
}

model CampaignExecution {
  id           String          @id @default(cuid())
  campaignId   String
  customerId   String
  status       ExecutionStatus @default(PENDING)
  sentAt       DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_executions")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum ExecutionStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ═══════════════════════════════════════════
//  CUSTOMER SEGMENTS  (Phase 3)
// ═══════════════════════════════════════════

model CustomerSegment {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  filters      Json
  memberCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  members    CustomerSegmentMembership[]
  campaigns  Campaign[]

  @@index([restaurantId])
  @@map("customer_segments")
}

model CustomerSegmentMembership {
  segmentId  String
  customerId String
  addedAt    DateTime @default(now())

  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([segmentId, customerId])
  @@map("customer_segment_memberships")
}

// ═══════════════════════════════════════════
//  OFFERS  (Phase 3)
// ═══════════════════════════════════════════

model Offer {
  id            String    @id @default(cuid())
  restaurantId  String
  title         String
  description   String?
  discount      Decimal   @db.Decimal(5, 2)
  type          OfferType
  code          String?
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("offers")
}

enum MenuSource {
  MANUAL    // created by restaurant staff via the dashboard
  EXTERNAL  // imported from a third-party POS or menu integration
}

enum OfferType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

// ═══════════════════════════════════════════
//  AI INTERACTION LOGS  (Phase 3)
// ═══════════════════════════════════════════

model AIInteractionLog {
  id               String   @id @default(cuid())
  restaurantId     String
  conversationId   String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  // Phase 4 additions
  turnNumber       Int      @default(0)    // which conversation turn (for multi-turn audit)
  toolCalls        Json?                   // array of {name, args, result} for every tool executed
  estimatedCostUsd Decimal? @db.Decimal(10, 6) // calculated from model pricing at log time
  createdAt        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([conversationId])
  @@map("ai_interaction_logs")
}

// ═══════════════════════════════════════════
//  EVOLUTION API CONFIG  (Phase 3)
//  Per-restaurant Evolution API credentials.
//  apiKey and webhookSecret are stored AES-256-GCM encrypted.
//  Plain values are NEVER returned in API responses — only masked.
//
//  Future: RestaurantBrandConfig will sit alongside this model and
//  provide per-tenant AI persona settings (tone, formality, vocabulary,
//  emoji usage, upsell style) consumed by the Phase 4 AI layer.
// ═══════════════════════════════════════════

model EvolutionConfig {
  id            String   @id @default(cuid())
  restaurantId  String   @unique
  instanceName  String   // Evolution instance identifier (used to route inbound webhooks)
  baseUrl       String   // e.g. https://evo.example.com
  apiKey        String   // AES-256-GCM encrypted
  webhookSecret String   // AES-256-GCM encrypted; used to verify inbound webhook signatures
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("evolution_configs")
}

// ═══════════════════════════════════════════
//  RESTAURANT BRAND CONFIG  (Phase 4)
//  Per-restaurant AI brand voice and ordering engine settings.
//  Injected into PromptBuilder to shape the AI's tone, style,
//  and behaviour for every conversation turn.
// ═══════════════════════════════════════════

model RestaurantBrandConfig {
  id                   String   @id @default(cuid())
  restaurantId         String   @unique

  // ── Voice & tone ────────────────────────────────────────────
  tone                 String   @default("friendly")
  // friendly | professional | casual | warm
  formality            String   @default("informal")
  // formal | informal | mixed
  emojiUsage           String   @default("moderate")
  // none | minimal | moderate | expressive
  communicationStyle   String   @default("conversational")
  // conversational | concise | detailed

  // ── Ordering behaviour ──────────────────────────────────────
  upsellStyle          String   @default("gentle")
  // none | gentle | moderate | proactive
  greetingTemplate     String?  // optional custom opening message

  // ── Advanced overrides ──────────────────────────────────────
  // When set, replaces the auto-generated system prompt entirely.
  // The token {CONTEXT} is replaced with the dynamic context block.
  systemPromptOverride String?

  // ── AI model settings ───────────────────────────────────────
  aiModel              String   @default("gpt-4o-mini")
  // gpt-4o-mini | gpt-4o
  maxHistoryMessages   Int      @default(20)
  // how many recent messages to include in the prompt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_brand_configs")
}

// ═══════════════════════════════════════════
//  WHATSAPP AGENT CONFIG
// ═══════════════════════════════════════════

model WhatsAppAgentConfig {
  id              String   @id @default(cuid())
  restaurantId    String   @unique

  // Personality
  agentName       String   @default("Agente")
  tone            String   @default("informal")      // informal | neutral | premium
  style           String   @default("sales_driven")  // direct | consultive | sales_driven

  // Welcome message
  welcomeMessage  String   @default("Olá! Bem-vindo! 😊 O que você deseja?")

  // Entry menu options — JSON array of { id, label, flow, message? }
  // flow: order | handoff | menu | promotions | custom
  menuOptions     Json?

  // Order action
  orderPreMessage String   @default("Ótimo! Aqui está nosso cardápio 👇")
  menuUrl         String?

  // Human handoff
  handoffPhone    String?
  handoffMessage  String   @default("Vou te conectar com um atendente. Um momento! 👋")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_agent_configs")
}

model MenuItemExtra {
  id         String  @id @default(cuid())
  menuItemId String
  name       String
  quantity   Int     @default(1)
  price      Decimal @db.Decimal(10, 2)

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_extras")
}

model MediaUpload {
  id           String   @id @default(cuid())
  restaurantId String
  mimeType     String
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@map("media_uploads")
}

// ═══════════════════════════════════════════
//  GENERAL SETTINGS
// ═══════════════════════════════════════════

model DeliveryConfig {
  id               String   @id @default(cuid())
  restaurantId     String   @unique
  enabled          Boolean  @default(true)
  fee              Decimal? @db.Decimal(10, 2)
  estimatedMinutes Int?
  areaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("delivery_configs")
}

model BusinessHours {
  id           String   @id @default(cuid())
  restaurantId String
  dayOfWeek    Int      // 0 = Sunday … 6 = Saturday
  isOpen       Boolean  @default(true)
  openTime     String   @default("09:00")   // "HH:MM"
  closeTime    String   @default("22:00")   // "HH:MM"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("business_hours")
}

model PaymentSettings {
  id            String   @id @default(cuid())
  restaurantId  String   @unique
  acceptPix     Boolean  @default(true)
  acceptCash    Boolean  @default(true)
  acceptCard    Boolean  @default(true)
  acceptLink    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

model StorePolicies {
  id                 String   @id @default(cuid())
  restaurantId       String   @unique
  termsOfUse         String?
  privacyPolicy      String?
  cancellationPolicy String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("store_policies")
}
