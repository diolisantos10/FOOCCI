// ═══════════════════════════════════════════
//  IMPORT JOBS

model ProductSalesAggregate {
  id           String   @id @default(cuid())
  restaurantId String
  sourceSystem String   @default("SAIPOS")
  periodStart  DateTime
  periodEnd    DateTime
  categoryName String
  productName  String?
