enum MenuItemEnhancementStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  APPROVED
  REJECTED
  LOW_SOURCE_QUALITY
  NEEDS_NEW_PHOTO
}

model MenuItemImageEnhancement {
