// ═══════════════════════════════════════════
//  GENERAL SETTINGS
// ═══════════════════════════════════════════

model DeliveryConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // Global toggles
  enabled       Boolean @default(true)
  pickupEnabled Boolean @default(true)

  // UI mode — "simple" | "advanced" | "distance"
  mode String @default("simple")

  // Simple-mode fields
  fee              Decimal? @db.Decimal(10, 2)
  estimatedMinutes Int?
  areaDescription  String?

  // Commercial rules (apply in all modes)
  minOrderValue     Decimal? @db.Decimal(10, 2)
  freeDeliveryAbove Decimal? @db.Decimal(10, 2) // free delivery above this order value

  // Distance-mode fields: fee = baseFee + (distanceKm * pricePerKm), clamped to [minFee, maxFee]
  distanceBaseFee       Decimal? @db.Decimal(10, 2)
  distancePricePerKm    Decimal? @db.Decimal(10, 2)
  distanceMaxKm         Float?
  distanceMinFee        Decimal? @db.Decimal(10, 2)
  distanceMinFeeKm      Float?                         // km included in minimumFee (new formula)
  distanceMaxFee        Decimal? @db.Decimal(10, 2)
  distanceEstimatedBase Int?

  // Phase 3 — dynamic pricing hooks (not yet active)
  peakHoursEnabled Boolean @default(false)
  peakHoursConfig  String? // JSON blob: [{ days, startTime, endTime, surchargePercent }]

  // Phase 5 — map-ready geographic anchor
  geoCenter   String? // JSON: { lat: number, lng: number }
  geoRadiusKm Float? // max delivery radius in km

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("delivery_configs")
}

// ── Delivery Zones (advanced mode) ─────────────────────────────────────────────
//  Each zone represents a distance tier with its own fee and estimated time.
//  Phase 3: peakFee field for future time-based surcharge.
//  Phase 5: geoPolygon field for future map-drawn boundaries.

model DeliveryZone {
  id           String @id @default(cuid())
  restaurantId String

  name             String // e.g. "Zona 1 — Centro", "Raio 5km"
  sortOrder        Int      @default(0)
  maxDistanceKm    Float // upper bound for this tier (km)
  fee              Decimal  @db.Decimal(10, 2)
  estimatedMinutes Int
  minOrderValue    Decimal? @db.Decimal(10, 2) // zone-level minimum (overrides global)
  isActive         Boolean  @default(true)

  // Phase 3 — time-based pricing hook
  peakFee Decimal? @db.Decimal(10, 2) // future: surge fee during peak hours

  // Phase 5 — map-ready boundary
  geoPolygon String? // future: JSON polygon [[lat,lng], …]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sortOrder])
  @@map("delivery_zones")
}

model BusinessHours {
  id           String   @id @default(cuid())
  restaurantId String
  dayOfWeek    Int // 0 = Sunday … 6 = Saturday
  isOpen       Boolean  @default(true)
  openTime     String   @default("09:00") // "HH:MM" — legacy single period open; use periodsJson when set
  closeTime    String   @default("22:00") // "HH:MM" — legacy single period close; use periodsJson when set
  periodsJson  Json?    // [{open:"HH:MM",close:"HH:MM"},…] — null means use openTime/closeTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("business_hours")
}

model PaymentSettings {
  id           String   @id @default(cuid())
  restaurantId String   @unique
  acceptPix    Boolean  @default(true)
  acceptCash   Boolean  @default(true)
  acceptCard   Boolean  @default(true)
  acceptLink   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

// ─── StoreProfile ─────────────────────────────────────────────────────────────
//  Complete fiscal, address, contact and operational data for the restaurant.
//  Extends the base Restaurant row without bloating it.

model StoreProfile {
  id           String @id @default(cuid())
  restaurantId String @unique

  // ── Dados da loja ──────────────────────────────────────────
  tradeName   String? // Nome fantasia
  legalName   String? // Razão social
  cuisineType String? // Tipo de cozinha / segmento

  // ── Dados fiscais ──────────────────────────────────────────
  cnpj                  String?
  stateRegistration     String? // Inscrição estadual
  municipalRegistration String? // Inscrição municipal
  taxRegime             String? // Regime tributário
  legalResponsibleName  String?
  legalResponsibleCpf   String?

  // ── Endereço estruturado ────────────────────────────────────
  cep            String?
  street         String?
  streetNumber   String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  country        String? @default("Brasil")
  referencePoint String?
  latitude       Float?
  longitude      Float?

  // ── Contatos ───────────────────────────────────────────────
  mainPhone         String?
  whatsappPhone     String?
  secondaryPhone    String?
  secondaryWhatsapp String?
  mainEmail         String?
  financeEmail      String?
  supportEmail      String?

  // ── Responsáveis ───────────────────────────────────────────
  ownerName       String?
  ownerRole       String?
  ownerPhone      String?
  ownerWhatsapp   String?
  ownerEmail      String?
  managerName     String?
  managerRole     String?
  managerPhone    String?
  managerWhatsapp String?
  managerEmail    String?

  // ── Operação ───────────────────────────────────────────────
  deliveryEnabled           Boolean @default(true)
  pickupEnabled             Boolean @default(true)
  dineInEnabled             Boolean @default(true)
  averagePreparationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("store_profiles")
}

model StorePolicies {
  id                 String   @id @default(cuid())
  restaurantId       String   @unique
  termsOfUse         String?
  privacyPolicy      String?
  cancellationPolicy String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("store_policies")
}

// ═══════════════════════════════════════════
//  PROMOTIONS  (Marketing Engine)
// ═══════════════════════════════════════════

enum PromotionType {
  PERCENTAGE // e.g. 10% off
  FIXED // e.g. R$5 off
  COMBO // bundled offer (configured via description/rules)
  FREE_DELIVERY // zeroes delivery fee
  COUPON // code-gated discount
  BANNER // visual banner displayed on all menus on scheduled day
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum PromotionChannel {
  QR_MENU
  DELIVERY
  WHATSAPP
  ALL
}

enum PromotionTarget {
  PRODUCT // applies to specific products
  CATEGORY // applies to a whole category
  ORDER // applies to the whole order
}

model Promotion {
  id            String          @id @default(cuid())
  restaurantId  String
  name          String
  description   String?
  type          PromotionType
  status        PromotionStatus @default(DRAFT)
  discountValue Decimal         @default(0) @db.Decimal(10, 2)

  // Targeting
  target            PromotionTarget  @default(ORDER)
  targetProductIds  String[]         @default([])
  targetCategoryIds String[]         @default([])
  channel           PromotionChannel @default(ALL)

  // Coupon
  couponCode String?

  // Banner (type=BANNER only)
  bannerImageUrl String?

  // Validity window
  startsAt   DateTime?
  endsAt     DateTime?
  daysOfWeek Int[]     @default([]) // 0=Sun … 6=Sat; empty = every day
  timeFrom   String? // "HH:MM" (local restaurant time)
  timeTo     String? // "HH:MM"

  // Eligibility rules
  minOrderValue  Decimal? @db.Decimal(10, 2)
  minQuantity    Int?
  maxUses        Int?
  usedCount      Int      @default(0)
  oneTimePerUser Boolean  @default(false)
  combinable     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("promotions")
}

// ═══════════════════════════════════════════
//  CRM AUTOMATIONS
// ═══════════════════════════════════════════

enum AutomationTrigger {
  REACTIVATION // fires after X days of customer inactivity
  BIRTHDAY // fires on customer birthday
  POST_ORDER // fires X days after a completed order
}

model CRMAutomation {
  id               String            @id @default(cuid())
  restaurantId     String
  trigger          AutomationTrigger
  isEnabled        Boolean           @default(false)
  messageTemplate  String            @default("")
  triggerAfterDays Int               @default(30)
  discountType     String? // "PERCENTAGE" | "FIXED" | null
  discountValue    Decimal?          @db.Decimal(10, 2)
  scheduleConfig   Json?   // { sendTime?, sendDays?, timezone? }
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, trigger])
  @@index([restaurantId])
  @@map("crm_automations")
}

/// Manually-created CRM action template by the restaurant owner.
/// Never triggers sending by itself — status stays DRAFT until a future
/// scheduling layer is built.
model CRMCustomAction {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  objective     String // RECUPERAR | RECOMPRA | TICKET | BEBIDA | SOBREMESA | AVALIACAO | VIP | ANIVERSARIO | OUTRO
  targetSegment String // TODOS | QUENTE | MORNO | FRIO | NOVOS | RECORRENTES | VIP | PRIMEIRO_PEDIDO | ...
  channel       String   @default("WHATSAPP") // WHATSAPP | MANUAL | CRM_AGENT
  message       String   @db.Text
  notes         String?  @db.Text
  status        String   @default("DRAFT") // DRAFT (only status for now)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("crm_custom_actions")
}

// ═══════════════════════════════════════════
//  CRM ADAPTIVE BRAIN
// ═══════════════════════════════════════════

enum CRMMessageStyle {
  FRIENDLY
  PLAYFUL
  DIRECT
  EMOTIONAL
  PREMIUM
}

/// Tone personality of the restaurant — biases style selection.
enum CRMToneProfile {
  CASUAL // boosts PLAYFUL + FRIENDLY
  PREMIUM_FEEL // boosts PREMIUM + EMOTIONAL
  FRIENDLY // boosts FRIENDLY + EMOTIONAL
  SALES_FORWARD // boosts DIRECT + PREMIUM
}

/// One row per CRM message dispatched. Outcomes updated asynchronously.
model CRMActionLog {
  id           String          @id @default(cuid())
  restaurantId String
  customerId   String?
  actionType   String // maps to MessageIntent values
  messageStyle CRMMessageStyle
  messageText  String
  responded    Boolean         @default(false)
  converted    Boolean         @default(false)
  revenue      Decimal?        @db.Decimal(10, 2)
  respondedAt  DateTime?
  convertedAt  DateTime?
  orderId      String? // denormalized Order.id — no FK to avoid cascade complexity
  // Structured action context (nullable, additive). For review requests:
  // { status: "sent"|"failed"|"skipped", platform: "GOOGLE"|"IFOOD", reviewLink, channel, error? }
  metadata     Json?
  createdAt    DateTime        @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, messageStyle])
  @@index([restaurantId, createdAt])
  @@map("crm_action_logs")
}

/// One row per restaurant. Tone preference + cached style weights.
model RestaurantCRMProfile {
  id                   String         @id @default(cuid())
  restaurantId         String         @unique
  toneProfile          CRMToneProfile @default(FRIENDLY)
  styleWeights         Json           @default("{}") // { FRIENDLY: 0.3, PLAYFUL: 0.2, ... }
  profileVersion       Int            @default(0)    // bumped each time weights are recomputed
  whatsAppSafetyConfig Json?                         // CRMWhatsAppSafetyConfig — global sending safety rules
  segmentConfig        Json?                         // SegmentConfig — relationship segment day thresholds
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_crm_profiles")
}

// ═══════════════════════════════════════════
//  AUTO SIMULATOR
// ═══════════════════════════════════════════

model AutoSimulatorConfig {
  id              String    @id @default(cuid())
  restaurantId    String    @unique
  enabled         Boolean   @default(false)
  intervalMinutes Int       @default(60)
  scenarioCount   Int       @default(10)
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("auto_simulator_configs")
}

model SimulationRun {
  id                String   @id @default(cuid())
  restaurantId      String
  ranAt             DateTime @default(now())
  scenarioCount     Int
  overallScore      Float
  conversionRate    Float
  attachRateDrink   Float
  attachRateDessert Float
  errorSummary      Json
  analysis          Json
  insight           String
  suggestedPrompt   String   @db.Text
  triggeredBy       String   @default("scheduler")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, ranAt])
  @@map("simulation_runs")
}

// ═══════════════════════════════════════════
//  TRACKING LINKS  (Channel attribution)
//  Each link represents a specific marketing channel / placement.
//  Customers arrive via /l/[restaurantSlug]/[trackingSlug] which
//  redirects to the destination and attaches UTM attribution.
// ═══════════════════════════════════════════

model TrackingLink {
  id              String  @id @default(cuid())
  restaurantId    String
  name            String // human label, e.g. "Instagram Bio"
  slug            String // URL-safe slug, e.g. "instagram-bio"
  destinationType String  @default("PEDIDO") // PEDIDO | QR
  source          String // utm_source — e.g. instagram, whatsapp, qr, google
  medium          String // utm_medium — e.g. bio, direct, mesa, embalagem
  campaign        String? // utm_campaign (optional)
  content         String? // utm_content  (optional)
  term            String? // utm_term     (optional)
  isActive        Boolean @default(true)

  // ── Short link ─────────────────────────────────────────────────
  shortCode       String? @unique // e.g. "k7m9qx3" — used for /r/[code] redirect

  // ── Aggregated metrics (incremented atomically) ────────────────
  clickCount              Int     @default(0)
  identifiedCustomerCount Int     @default(0)
  orderStartedCount       Int     @default(0)
  orderCompletedCount     Int     @default(0)
  revenue                 Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@map("tracking_links")
}

// ═══════════════════════════════════════════
//  RELATIONSHIP PROGRAM
// ═══════════════════════════════════════════

/// Per-restaurant tier thresholds. If absent, defaults from crm-helpers are used.
model TierSettings {
  id           String @id @default(cuid())
  restaurantId String @unique

  /// PRATA thresholds (OR logic — either is enough to qualify)
  silverMinSpend  Decimal @default(300) @db.Decimal(10, 2)
  silverMinOrders Int     @default(0) // 0 = spend-only

  /// OURO thresholds
  goldMinSpend  Decimal @default(800) @db.Decimal(10, 2)
  goldMinOrders Int     @default(0)

  /// DIAMANTE thresholds
  diamondMinSpend  Decimal @default(2000) @db.Decimal(10, 2)
  diamondMinOrders Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("tier_settings")
}

/// Custom benefits per tier, configured by the restaurant.
model TierBenefit {
  id           String   @id @default(cuid())
  restaurantId String
  tier         String // BRONZE | PRATA | OURO | DIAMANTE
  title        String
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, tier])
  @@map("tier_benefits")
}

// ═══════════════════════════════════════════
//  ONBOARDING
// ═══════════════════════════════════════════

model RestaurantOnboardingStatus {
  id                   String    @id @default(cuid())
  restaurantId         String    @unique
  finalTestCompletedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_onboarding_statuses")
}

// ═══════════════════════════════════════════
//  CUSTOMER INTELLIGENCE
// ═══════════════════════════════════════════

/// Inferred or collected data signals about a customer.
/// Confirmed signals must not auto-overwrite confirmed Customer fields.
model CustomerDataSignal {
  id           String @id @default(cuid())
  restaurantId String
  customerId   String

  /// PREFERENCE | POSSIBLE_FAVORITE_PRODUCT | MISSING_FIELD | ADDRESS_CLUE | BIRTHDAY_REQUESTED | NAME_CLUE
  type String

  /// Which customer field this signal pertains to (e.g. "birthDate", "address", "preferences.dietary")
  field String?

  /// The inferred or collected value (stringified)
  value String?

  /// 0–1 confidence score (1 = confirmed)
  confidence Float?

  /// IMPORT | ORDER_HISTORY | WHATSAPP_CONVERSATION | HUMAN_NOTE | CRM_CAMPAIGN | ANALYTICS
  source String

  /// INFERRED | CONFIRMED | REJECTED | NEEDS_REVIEW
  status String @default("INFERRED")

  notes      String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([restaurantId, status])
  @@map("customer_data_signals")
}

// Lightweight page-view event fired when a customer opens the delivery menu.
// Used to compute visits-by-source without touching the Order table.
model MenuEvent {
  id           String   @id @default(cuid())
  restaurantId String
  /// Normalized source: instagram | whatsapp | google | qrcode | crm | manual | direct | other
  source       String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, source])
  @@index([restaurantId, createdAt])
  @@map("menu_events")
}

// ═══════════════════════════════════════════
//  RESTAURANT KNOWLEDGE BASE
// ═══════════════════════════════════════════
//
// Stores facts, FAQs and operational answers learned from human conversations
// or entered manually. The WhatsApp Agent uses ACTIVE items to answer customers
// without hallucinating. SUGGESTED items await owner approval.

model RestaurantKnowledgeItem {
  id           String   @id @default(cuid())
  restaurantId String

  // Human-readable title for the owner (not shown to customer)
  title    String
  category String // FAQ | POLICY | PROMOTION | BUSINESS_HOURS | DELIVERY_INFO | RODIZIO_INFO | BIRTHDAY_BENEFIT | PAYMENT_INFO | HUMAN_HANDOFF_RULE | UNKNOWN_GAP

  // Example phrases the customer might use — used for keyword matching
  questionPatterns Json // string[]

  // What the agent will say to the customer (empty when status=UNKNOWN_GAP)
  answer String @default("")

  // Lifecycle: SUGGESTED → APPROVED/REJECTED → ACTIVE
  status String @default("SUGGESTED") // SUGGESTED | APPROVED | REJECTED | ACTIVE

  // Origin of this knowledge item
  source String // HUMAN_REPLY | MANUAL | AI_SUGGESTED | IMPORTED

  // Confidence score (0.0–1.0); null means manually set / unconditional
  confidence Float?

  // Audit trail — links this item back to the conversation it was learned from
  createdFromConversationId String?
  createdFromMessageIds     Json? // string[]

  // Usage stats
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, category])
  @@map("restaurant_knowledge_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
//  MANUAL OPERACIONAL DO FOOCCI (INTERNAL — Admin/Master only)
//
//  This is the internal "operational bible" for Foocci/Fute.
//  It documents product rules, AI agent behaviour, flows, integrations,
//  UI rules, CRM rules, WhatsApp rules, checkout rules, and operational
//  decisions.
//
//  Phase 1: database structure + admin APIs + admin UI + version/publish flow.
//  Agents do NOT query this manual yet. RAG/embeddings come in a later phase.
//  Only content with isPublished=true and agentVisibility=true will be surfaced
//  to agents — but that gate is not open yet.
//
//  Change requests MUST be approved before any chapter is published.
// ═══════════════════════════════════════════════════════════════════════════════

/// Module area / domain that a chapter or decision belongs to.
enum ManualArea {
  GENERAL
  WAITER_AGENT
  CRM
  WHATSAPP
  UI_UX
  BRANDING
  INTEGRATIONS
  CHECKOUT
  PAYMENTS
  ANALYTICS
  SECURITY
  BACKLOG
}

/// Lifecycle status of a chapter or decision.
enum ManualRuleStatus {
  IMPLEMENTED
  PARTIAL
  DECIDED
  BACKLOG
}

/// Workflow status for a pending change request.
enum ManualChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Where a change or decision originated.
enum ManualSourceType {
  CHATGPT
  CLAUDE_AUDIT
  CODE_AUDIT
  MANUAL
  DEPLOY
  BUGFIX
  PRODUCT_DECISION
}

/// A chapter in the Foocci Operational Manual.
/// Each chapter has a versioned content body, a lifecycle status, and an
/// optional flag for future agent visibility.
model OperationalManualChapter {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  area            ManualArea       @default(GENERAL)
  description     String?
  content         String           @db.Text
  status          ManualRuleStatus @default(BACKLOG)
  version         String           @default("0.1")
  isPublished     Boolean          @default(false)
  /// When true, agents may read this chapter (gate not yet open — Phase 2+).
  agentVisibility Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  approvedBy      String?

  revisions      OperationalManualRevision[]
  changeRequests OperationalManualChangeRequest[]

  @@index([area])
  @@index([status])
  @@index([isPublished])
  @@map("operational_manual_chapters")
}

/// Immutable snapshot of a chapter at a specific version.
/// Created automatically on every publish action.
model OperationalManualRevision {
  id              String           @id @default(cuid())
  chapterId       String
  version         String
  content         String           @db.Text
  changeSummary   String?
  sourceType      ManualSourceType @default(MANUAL)
  sourceReference String?
  createdAt       DateTime         @default(now())
  createdBy       String?

  chapter OperationalManualChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("operational_manual_revisions")
}

/// A proposed change to one or more chapters, waiting for admin approval.
/// Nothing becomes official content without an APPROVED change request.
model OperationalManualChangeRequest {
  id              String             @id @default(cuid())
  chapterId       String?
  title           String
  proposedContent String             @db.Text
  proposedDiff    String?            @db.Text
  reason          String
  impactAreas     String?
  status          ManualChangeStatus @default(PENDING)
  sourceType      ManualSourceType   @default(MANUAL)
  sourceReference String?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  createdBy       String?
  reviewedBy      String?

  chapter OperationalManualChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([status])
  @@map("operational_manual_change_requests")
}

/// Permanent log of product and operational decisions, independently of chapters.
/// Useful for answering "why did we decide X?" without editing live chapter content.
model OperationalManualDecisionLog {
  id              String           @id @default(cuid())
  title           String
  description     String           @db.Text
  area            ManualArea       @default(GENERAL)
  status          ManualRuleStatus @default(DECIDED)
  sourceType      ManualSourceType @default(PRODUCT_DECISION)
  sourceReference String?
  createdAt       DateTime         @default(now())
  createdBy       String?

  @@index([area])
  @@index([status])
  @@map("operational_manual_decision_logs")
}

// ═══════════════════════════════════════════
//  AI AGENTS ADMIN — FOUNDATION (Phase 1)
// ═══════════════════════════════════════════
//
//  Internal foundation for the future "Admin → AI Agents" area.
//
//  ┌────────────────────────────────────────────────────────────────────────┐
//  │  SOURCE-OF-TRUTH PRECEDENCE (do NOT violate)                            │
//  │                                                                        │
//  │  1. HARDCODED safety / protocol rules = the IMMUTABLE FLOOR.            │
//  │     - src/lib/agent/protocol.ts  → ABSOLUTE_RULES                       │
//  │     - src/services/ai/waiter/WaiterAgentProfile.ts → SAFETY_BOUNDARIES  │
//  │     These are never overridable by DB rows, ever.                      │
//  │  2. MASTER AgentProfile (these tables) may ENRICH behavior.            │
//  │  3. RestaurantAgentProfileOverride may PERSONALIZE tone only —         │
//  │     it can NEVER override safety / forbidden rules.                    │
//  │                                                                        │
//  │  RUNTIME USE IS DISABLED in Phase 1. The Waiter runtime still reads    │
//  │  exclusively from the code-defined constitution. These rows are        │
//  │  data-only (seed + future Admin UI). The `isRuntimeEnabled` column     │
//  │  and the AGENT_PROFILE_DB_ENABLED env flag both default to OFF and     │
//  │  gate any future DB-driven runtime (Phase 3).                          │
//  └────────────────────────────────────────────────────────────────────────┘

/// Logical area / department of an AI agent. Mirrors the agent registry.
enum AgentArea {
  ORCHESTRATOR // Manager agent that coordinates the others
  SECURITY     // Security & Governance agent
  WAITER       // Sales / ordering agent inside /pedido
  WHATSAPP     // Inbound WhatsApp receptionist
  CRM          // Outbound relationship agent
  UI_UX        // UI/UX agent
  MANUAL       // Manual / Constitution agent
  QA           // QA / Test agent
  INTEGRATION  // Integration agent
  BRANDING     // Branding agent
  ANALYTICS    // Analytics / Product agent
  GENERAL
}

/// Lifecycle status of an agent profile.
enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Who is allowed to SEE an agent profile.
/// INTERNAL = master/internal admins only (never exposed to restaurant users).
enum AgentVisibility {
  INTERNAL
  RESTAURANT
  PUBLIC
}

/// Master, global definition of an AI agent's professional profile.
/// One row per logical agent (Waiter, WhatsApp, CRM, …). Structured sections
/// map 1:1 to the future Admin → Agents editor. Rich, normalized-where-cheap,
/// JSON-where-flexible (objectives/rules/examples are arrays, not tables).
///
/// SAFETY: `forbiddenActions` and `safetyRules` are INTERNAL/master-only and
/// are NEVER editable or visible to restaurant users.
model AgentProfile {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  title       String?
  area        AgentArea       @default(GENERAL)
  description String?         @db.Text

  // ── Professional identity (structured sections) ──
  mission            String? @db.Text
  objectives         Json    @default("[]") // string[]
  responsibilities   Json    @default("[]") // string[]
  skills             Json    @default("[]") // string[]
  allowedActions     Json    @default("[]") // string[]  (CAN_DO)
  forbiddenActions   Json    @default("[]") // string[]  (CANNOT_DO) — INTERNAL ONLY
  tools              Json    @default("[]") // string[]
  knowledgeAreas     Json    @default("[]") // string[]  (Phase 4 will link real items)
  interfaceContext   String? @db.Text
  businessRules      Json    @default("[]") // string[]
  safetyRules        Json    @default("[]") // string[]  (SAFETY_BOUNDARIES) — INTERNAL ONLY, IMMUTABLE FLOOR
  escalationRules    Json    @default("[]") // string[]
  promptInstructions String? @db.Text
  outputRules        Json    @default("[]") // string[]
  evaluationCriteria Json    @default("[]") // string[]

  /// Agent-specific rich sections that do not deserve their own columns yet
  /// (e.g. Waiter: salesPrinciples, menuReadingRules, examples, …).
  /// Kept as JSON to evolve without migrations until patterns stabilize.
  extendedSections Json? // Record<string, unknown>

  // ── Governance / lifecycle ──
  status          AgentStatus     @default(DRAFT)
  visibility      AgentVisibility @default(INTERNAL)
  isGlobalDefault Boolean         @default(true)
  /// Master kill-switch for DB-driven runtime for THIS agent. OFF in Phase 1.
  isRuntimeEnabled Boolean        @default(false)
  version         String          @default("0.1")
  /// Where the row originated: CODE_SEED | MANUAL | IMPORT | …
  source          String?         @default("CODE_SEED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  versions  AgentProfileVersion[]
  overrides RestaurantAgentProfileOverride[]

  @@index([area])
  @@index([status])
  @@index([visibility])
  @@map("agent_profiles")
}

/// Immutable snapshot of an AgentProfile at a specific version.
/// Created on every meaningful edit (Phase 2+). Enables history / rollback /
/// "why did the Waiter change?" audits — the same pattern as the Operational
/// Manual revisions.
model AgentProfileVersion {
  id             String   @id @default(cuid())
  agentProfileId String
  version        String
  /// Full structured snapshot of the profile at this version.
  snapshot       Json
  changeSummary  String?
  source         String?  @default("MANUAL")
  createdAt      DateTime @default(now())
  createdBy      String?

  profile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  @@index([agentProfileId])
  @@map("agent_profile_versions")
}

/// Per-restaurant personalization of a master agent profile.
///
/// SAFETY: this layer may ONLY personalize tone/voice and ADD non-safety
/// enrichment. It can NEVER override `forbiddenActions` / `safetyRules` from
/// the master profile, nor the hardcoded protocol floor. The application layer
/// enforces this; the schema deliberately exposes no safety columns here.
model RestaurantAgentProfileOverride {
  id             String  @id @default(cuid())
  restaurantId   String
  agentProfileId String

  displayName        String?
  toneOverride       String?
  styleOverride      String?
  /// Free-text additions from the restaurant owner. Injected AFTER all hard
  /// rules (same contract as RestaurantBrandConfig.waiterPrompt). Never safety.
  customInstructions String? @db.Text
  /// Non-safety enrichment sections (e.g. local specialties, seasonal notes).
  enrichmentSections Json?
  /// Whether this restaurant has opted into the override. OFF by default.
  isEnabled          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  profile    AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, agentProfileId])
  @@index([restaurantId])
  @@index([agentProfileId])
  @@map("restaurant_agent_profile_overrides")
}

// TODO (Phase 4 — Knowledge Library): AgentKnowledgeRef
// A join model linking an AgentProfile to concrete knowledge sources
// (RestaurantKnowledgeItem, OperationalManualChapter with agentVisibility=true).
// Intentionally NOT created in Phase 1 — knowledge governance + the manual
// `agentVisibility` gate are Phase 4 concerns. Until then, AgentProfile.knowledgeAreas
// holds plain string labels only.

// ═══════════════════════════════════════════
//  BUILD OS — PROMPT RELAY / COMMAND ROUTER (Priority 1.1)
// ═══════════════════════════════════════════
//
//  Project-agnostic command intake foundation. Foocci is the first project, but
//  these models deliberately have NO `restaurantId` — tenancy is by BuildProject.
//
//  ┌────────────────────────────────────────────────────────────────────────┐
//  │  SCOPE (Priority 1.1) — intake + persistence + audit ONLY                │
//  │   • An authorized operator sends a WhatsApp command (/build, /cmd,        │
//  │     /prompt). It is stored as a BuildCommand with append-only events.     │
//  │   • NO Claude relay, NO GitHub issues, NO LLM prompt generation,          │
//  │     NO code execution. Confirmation reply only.                           │
//  │  SECURITY: only allow-listed phone numbers create records. Unauthorized   │
//  │     senders are ignored (no record, no sensitive reply).                  │
//  └────────────────────────────────────────────────────────────────────────┘

enum BuildCommandStatus {
  RECEIVED
  DRAFTED
  AWAITING_CONFIRMATION
  APPROVED_FOR_RELAY
  REVISION_REQUESTED
  CANCELLED
  FAILED
}

/// How a stored prompt draft was produced. Priority 1.4 = TEMPLATE only (no LLM).
enum BuildPromptKind {
  TECHNICAL_DRAFT
}

enum BuildPromptGeneratedBy {
  TEMPLATE
}

enum BuildCommandSourceChannel {
  WHATSAPP
  ADMIN
}

enum BuildRiskLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BuildTaskType {
  UNKNOWN
  FEATURE
  FIX
  REFACTOR
  AUDIT
  DOCS
  UI_UX
  CONFIG
  TEST
  SECURITY
}

/// Deterministic execution intent inferred from the command text (Priority 1.3).
enum BuildExecutionIntent {
  UNKNOWN
  AUDIT_ONLY
  IMPLEMENT
  FIX
  REVIEW
  EXPLAIN
}

/// A project the Build OS can receive commands for. Project-agnostic tenancy:
/// NOT tied to Restaurant. Foocci is seeded as the default project.
model BuildProject {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  description   String?
  defaultBranch String  @default("main")
  githubOwner   String?
  githubRepo    String?
  isDefault     Boolean @default(false)
  isActive      Boolean @default(true)

  // ── Priority 1.2: registry metadata (no secrets; GitHub fields are metadata
  //    only — never tokens). projectRules/promptContext are high-level notes
  //    used by FUTURE phases; nothing here drives runtime or prompt generation.
  projectRules Json?   // string[] of high-level rules (no secrets)
  promptContext String? @db.Text // freeform context block for later prompt phases
  displayOrder Int     @default(0)
  category     String? // e.g. "platform", "agency", "experiment"
  riskNotes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commands BuildCommand[]

  @@index([isActive])
  @@map("build_projects")
}

/// Allow-list of operators permitted to issue Build OS commands.
/// Build OS operator identity is SEPARATE from any restaurant customer.
/// `allowedProjectIds` is a JSON string[] of BuildProject ids; an empty array
/// means "all active projects" (resolved in the service layer).
model BuildAuthorizedSender {
  id                String  @id @default(cuid())
  /// Normalized E.164 phone, e.g. "+5511999990000". Unique. (canonical match key)
  phone             String  @unique
  /// Raw value the admin typed (for display); the canonical match uses `phone`.
  rawPhone          String?
  name              String?
  role              String  @default("operator")
  isActive          Boolean @default(true)
  allowedProjectIds Json    @default("[]") // string[] of BuildProject ids ([] = all)
  notes             String?
  lastUsedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("build_authorized_senders")
}

/// Operating mode for Build OS (Priority 1.4.1).
enum BuildOSMode {
  INTERNAL_ONLY
  PRODUCT
}

/// ADMIN/SYSTEM-level WhatsApp channel for Build OS — the Foocci/Futi Admin
/// command line. Completely independent of any restaurant/tenant: it has NO
/// restaurantId. Diego/CEO sends internal commands here and names the target
/// (restaurant/agent/area) inside the message. Credentials are stored encrypted
/// and never tied to a Restaurant row. Singleton-ish (most recent row wins).
model BuildOSMasterWhatsAppConfig {
  id            String   @id @default(cuid())
  /// Evolution instance dedicated to the Admin channel, e.g. "futi-admin".
  instanceName  String   @unique
  /// Evolution server base URL, e.g. https://evo.example.com
  baseUrl       String
  /// AES-256-GCM encrypted Evolution API key/token. Never returned in full.
  apiKey        String
  /// AES-256-GCM encrypted webhook secret used to verify inbound webhook signatures.
  webhookSecret String
  isEnabled     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("buildos_master_whatsapp_config")
}

/// Singleton-ish runtime configuration for Build OS, editable from the admin UI
/// WITHOUT touching env vars / Railway. Env vars remain bootstrap/emergency only.
/// There is normally exactly one active row (the most recent is authoritative).
model BuildOSConfig {
  id        String      @id @default(cuid())
  isEnabled Boolean     @default(false)
  mode      BuildOSMode @default(INTERNAL_ONLY)
  /// Optional override for the default project; falls back to BuildProject.isDefault.
  defaultProjectId String?
  /// When true, env BUILD_OS_AUTHORIZED_PHONES is allowed as a fallback even when
  /// DB senders exist. When false, DB authorized senders are the sole source once any exist.
  allowEnvAuthorizedPhonesFallback Boolean @default(true)

  /// ── Build OS WhatsApp Master/Admin channel (separate from restaurant WhatsApp) ──
  /// The Evolution instanceName dedicated to internal Build OS commands (Diego/CEO).
  /// NULL = no Master channel configured yet → diagnostics must say "não configurado"
  /// and must NOT assume a restaurant instance (e.g. sushicazza) is the Build OS channel.
  whatsappInstanceName String?
  /// Whether the Master channel is active. When false, Build OS won't process commands
  /// even from the configured instance.
  whatsappEnabled Boolean @default(false)
  /// EMERGENCY/TEMPORARY only: allow restaurant instances to act as the Build OS channel.
  /// Default OFF — restaurant WhatsApp must never be the Build OS command channel unless
  /// this is explicitly enabled (and the UI labels it "fallback legado — não recomendado").
  legacyRestaurantInstanceFallbackEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("build_os_config")
}

/// A single command received from an authorized operator. Raw + parsed parts are
/// stored; classification (risk/task) defaults to UNKNOWN in Priority 1.1.
model BuildCommand {
  id            String                    @id @default(cuid())
  projectId     String? // optional until project resolution is implemented
  senderPhone   String // normalized E.164
  senderName    String?
  sourceChannel BuildCommandSourceChannel @default(WHATSAPP)
  rawMessage    String                    @db.Text
  commandPrefix String // "/build" | "/cmd" | "/prompt"
  commandText   String                    @db.Text // raw message minus the prefix
  status        BuildCommandStatus        @default(RECEIVED)
  riskLevel     BuildRiskLevel            @default(UNKNOWN)
  taskType      BuildTaskType             @default(UNKNOWN)
  receivedAt    DateTime                  @default(now())

  // ── Priority 1.3: deterministic (non-LLM) classification metadata ──
  executionIntent          BuildExecutionIntent @default(UNKNOWN)
  targetArea               String? // e.g. "checkout", "whatsapp", "waiter", "buildos", "unknown"
  requiresHumanConfirmation Boolean             @default(true)
  classificationSummary    String? // short human-readable summary

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project BuildProject?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events  BuildCommandEvent[]
  promptVersions BuildPromptVersion[]

  @@index([status])
  @@index([senderPhone])
  @@index([projectId])
  @@index([createdAt])
  @@map("build_commands")
}

/// Append-only audit log for a command's lifecycle.
model BuildCommandEvent {
  id        String   @id @default(cuid())
  commandId String
  type      String // RECEIVED | CONFIRMATION_SENT | ...
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  command BuildCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([commandId])
  @@map("build_command_events")
}

/// Diagnostic trace of EVERY Build OS webhook attempt (Priority 1.4.1 debug).
/// Persisted so the admin can confirm — without console/Railway — whether the
/// REAL Evolution webhook reached the Build OS branch and what happened. Holds
/// no secrets; the phone is stored masked. Best-effort write; never blocks the
/// webhook. Trimmed by keeping only recent rows in the admin view.
model BuildWebhookTrace {
  id              String   @id @default(cuid())
  /// Evolution instanceName the event arrived on — lets diagnostics show whether a
  /// /build came from the Build OS Master channel or a restaurant instance.
  instanceName    String?
  /// Masked phone (e.g. "+55***0692"). Never the full number.
  maskedPhone     String?
  /// Full normalized E.164 sender, stored SERVER-SIDE ONLY so the admin can
  /// authorize an unauthorized /build sender by traceId without the full number
  /// ever leaving the backend. NEVER returned in any API/view — masked only.
  rawPhone        String?
  prefixDetected  String?
  configEnabled   Boolean?
  configSource    String?
  authorized      Boolean?
  fromMe          Boolean?
  commandCreated  Boolean  @default(false)
  promptDrafted   Boolean  @default(false)
  responseSent    Boolean  @default(false)
  shortCircuited  Boolean  @default(false)
  failureReason   String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("build_webhook_traces")
}

/// A stored, versioned prompt draft for a command (Priority 1.4).
/// Generated deterministically from a TEMPLATE — never by an LLM in this phase.
/// Stored internally only; the full text is visible solely in the admin area.
model BuildPromptVersion {
  id                 String                 @id @default(cuid())
  commandId          String
  versionNumber      Int                    @default(1)
  promptText         String                 @db.Text
  promptKind         BuildPromptKind        @default(TECHNICAL_DRAFT)
  generatedBy        BuildPromptGeneratedBy @default(TEMPLATE)
  /// When this version was produced by an AJUSTAR reply, the operator's instruction.
  revisionInstruction String?               @db.Text
  createdAt          DateTime               @default(now())

  command BuildCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@unique([commandId, versionNumber])
  @@index([commandId])
  @@map("build_prompt_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Agency OS — Client Projects + AI Strategy Room
// ─────────────────────────────────────────────────────────────────────────────

enum AgencyProjectStatus {
  DRAFT
  STRATEGY_PENDING
  STRATEGY_DONE
  PROPOSAL_READY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StrategyRoomStatus {
  PENDING
  DONE
  ERROR
}

/// An internal agency engagement for a restaurant client.
/// Tracks a project from intake → strategy → proposal → execution.
model AgencyProject {
  id           String              @id @default(cuid())
  restaurantId String
  name         String
  objective    String              @db.Text
  audience     String?             @db.Text
  timeline     String?
  budget       String?
  services     Json                @default("[]") // string[] of service names
  notes        String?             @db.Text
  status       AgencyProjectStatus @default(DRAFT)

  strategySession StrategyRoomSession?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@map("agency_projects")
}

/// AI Strategy Room session — 6 specialist perspectives + final synthesis.
/// Generated by StrategyRoomService (rule-based, no external LLM calls).
model StrategyRoomSession {
  id        String             @id @default(cuid())
  projectId String             @unique
  status    StrategyRoomStatus @default(DONE)

  /// Snapshot of brand config + brief used at generation time
  briefSnapshot Json

  /// Individual specialist outputs (SpecialistOutput JSON)
  strategist     Json
  socialMedia    Json
  creative       Json
  paidTraffic    Json
  businessScope  Json
  criticalReview Json

  /// Final cross-specialist synthesis
  synthesis Json

  generatedAt DateTime @default(now())

  project AgencyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("strategy_room_sessions")
}
